</style>
<div id=list></div><div id=main><p class=sub>Pick an application on the left.</p></div>
<script>
const B=location.pathname.replace(/\/$/,'');let cur=null,data=[],dirty={};
const GROUPS=[['ready','Ready to submit'],['review','To review'],['draft','Needs answers'],['approved','Queued to fill'],['filling','Filling now'],['blocked','Stopped'],['submitted','Submitted'],['skipped','Skipped or closed']];
const el=(t,a={},...k)=>{const e=document.createElement(t);for(const[x,y]of Object.entries(a)){if(x==='on')e.onclick=y;else if(x==='text')e.textContent=y;else e.setAttribute(x,y)}for(const c of k)if(c!=null)e.append(c);return e};
async function api(p,body){const r=await fetch(B+p,body?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}:{});return r.json()}
function list(){const L=document.querySelector('#list');L.replaceChildren();for(const[s,name]of GROUPS){const xs=data.filter(d=>d.state===s);if(!xs.length)continue;L.append(el('h3',{text:name+' ('+xs.length+')'}));for(const d of xs){const n=d.state==='draft'?d.missing+' to answer':d.state==='review'?(d.review?d.review+' to read':'nothing unusual'):d.blockers[0]||'';L.append(el('div',{class:'item'+(cur===d.id?' on':''),on:()=>show(d.id)},el('b',{text:d.company||'?'}),' ',el('span',{text:(d.title||'').slice(0,60)}),el('small',{text:n})))}}}
async function refresh(){data=await api('/data');list();if(cur){const d=data.find(x=>x.id===cur);if(d&&d.state!==shown)show(cur)}}
let shown=null;
function input(q){const v=q.display==null?'':q.display;let e;if(q.options&&q.options.length&&q.kind!=='checks'){e=el('select',{},el('option',{value:'',text:'(no answer)'}),...q.options.map(o=>el('option',{value:o,text:o})));e.value=Array.isArray(v)?v[0]||'':v}else if(q.kind==='textarea'||String(v).length>90){e=el('textarea');e.value=Array.isArray(v)?v.join(', '):v}else{e=el('input');e.value=Array.isArray(v)?v.join(', '):v}e.oninput=()=>{dirty[q.key]=e.value};return e}
async function show(id){cur=id;dirty={};const p=await api('/p/'+id);shown=p.state;list();const M=document.querySelector('#main');M.replaceChildren();
 const bar=el('div',{class:'bar'});const msg=el('span',{id:'msg'});
 const save=async()=>{if(Object.keys(dirty).length){await api('/act',{k:'edit',id,values:dirty});dirty={}}};
 if(['review','draft','blocked','ready'].includes(p.state))bar.append(el('button',{on:async()=>{await save();const r=await api('/act',{k:'approve',id});msg.textContent=r.message;refresh();show(id)}},p.state==='ready'?'Fill again':'Approve and fill'));
 if(p.state==='ready'){bar.append(el('button',{on:async()=>{msg.textContent='Checking the form is still live...';const r=await api('/act',{k:'open',id});msg.textContent=r.message;if(r.link){live=true;window.open(r.link,'herald-live')}refresh()}},'Open form to submit'));bar.append(el('button',{class:'alt',on:async()=>{const r=await api('/act',{k:'submitted',id});msg.textContent=r.message;live=false;refresh()}},'I submitted it'))}
 if(p.state==='blocked')bar.append(el('button',{class:'alt',on:async()=>{msg.textContent='Opening...';const r=await api('/act',{k:'show',id});msg.textContent=r.message;if(r.link)window.open(r.link,'herald-live')}},'Open in browser to fix'));
