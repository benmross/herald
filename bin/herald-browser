#!/usr/bin/env python3
"""The profile browser, and the page the user drives it from. See lib/herald/browse.py.

Two jobs in one process, because the second needs the first:

1. Keep one Chromium running with the persistent profile, its DevTools port on
   127.0.0.1 only. Headed inside a private Xvfb display when Xvfb is installed
   (sign-in pages are warier of a headless browser), headless otherwise. If it
   exits, it is started again.
2. Serve the view page on 127.0.0.1 (`surfaces.browser_view.port`), which
   `tailscale serve` or similar puts in front of the user's phone. A
   `herald browse login` link opens it: a live screen of the browser with that
   tab in front, and a Done button that hands the tab back. This is how the
   user signs in to a site without a password passing through a model.

This process does not drive pages. Anything it needs from one (bring the tab
to the front, size its window, a picture of it) it asks of the browse daemon,
which is the only Playwright client. It used to keep a connection of its own,
and a restart of either side left the other holding a dead one.

Every route is keyed by an unguessable token that expires. An unknown,
expired or closed token gets the same plain 404. Nothing typed is logged.
"""

from __future__ import annotations

import html
import json
import os
import pathlib
import shutil
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))

from herald import browse, browse_daemon, config, db  # noqa: E402

HEADERS = {
    "Cache-Control": "no-store",
    "Referrer-Policy": "no-referrer",
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
}

PAGE = """<!doctype html><meta charset=utf-8>
<meta name=viewport content="width=device-width,initial-scale=1,maximum-scale=1">
<meta name=robots content=noindex><title>Herald browser</title>
<style>
body{margin:0;font:15px -apple-system,system-ui,sans-serif;background:#151515;color:#e8e8e8}
#bar{display:flex;gap:.3rem;padding:.4rem;position:sticky;top:0;background:#151515;z-index:2;flex-wrap:wrap}
#bar input{flex:1;min-width:8rem;font-size:16px;padding:.45rem;border-radius:6px;border:1px solid #444;background:#1f1f1f;color:#e8e8e8}
button{font-size:15px;padding:.45rem .7rem;border:0;border-radius:6px;background:#e8e8e8;color:#151515}
button.q{background:#333;color:#e8e8e8}
#why{padding:.2rem .6rem .5rem;color:#aaa;font-size:13px}
#scr{width:100%;display:block;touch-action:manipulation}
#st{font-size:12px;color:#888;padding:.2rem .6rem}
</style>
<div id=why>__WHY__</div>
<div id=bar>
<input id=t placeholder="type here, then Send" autocomplete=off autocapitalize=off spellcheck=false>
<button id=send>Send</button><button class=q data-k=Enter>⏎</button>
<button class=q data-k=Tab>Tab</button><button class=q data-k=Backspace>⌫</button>
</div>
<div id=bar2 style="display:flex;gap:.3rem;padding:0 .4rem .4rem">
<button class=q id=up>▲</button><button class=q id=dn>▼</button>
<button class=q id=back>Back</button><button class=q id=re>Refresh</button>
<button id=done style="margin-left:auto">Done</button></div>
<div id=st></div>
<img id=scr alt="">
<script>
const B=location.pathname.replace(/\\/$/,''), img=document.getElementById('scr'), st=document.getElementById('st');
let busy=false;
function frame(){ img.src=B+'/frame?'+Date.now(); }
let fails=0;
img.onload=()=>{busy=false; fails=0; st.textContent=''};
// One failed frame is usually a tab that was just opened; keep polling, and
// only call the link dead after it has failed for a while.
img.onerror=()=>{busy=false; fails++; st.textContent = fails>5 ? 'this link has expired or the browser stopped' : 'waiting for the browser…'};
async function act(o){ st.textContent='…'; const r=await fetch(B+'/act',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(o)});
  st.textContent=r.ok?'':'that did not work ('+r.status+')'; setTimeout(frame,350); setTimeout(frame,1500); }
img.addEventListener('click',e=>{const r=img.getBoundingClientRect();
  act({k:'click',x:(e.clientX-r.left)*img.naturalWidth/r.width,y:(e.clientY-r.top)*img.naturalHeight/r.height});});
document.getElementById('send').onclick=()=>{const t=document.getElementById('t'); if(t.value){act({k:'type',text:t.value}); t.value='';}};
document.querySelectorAll('[data-k]').forEach(b=>b.onclick=()=>act({k:'key',key:b.dataset.k}));
document.getElementById('up').onclick=()=>act({k:'scroll',dy:-600});
document.getElementById('dn').onclick=()=>act({k:'scroll',dy:600});
document.getElementById('back').onclick=()=>act({k:'back'});
document.getElementById('re').onclick=frame;
document.getElementById('done').onclick=async()=>{await act({k:'done'}); document.body.innerHTML='<p style="padding:1rem">Done. Herald can carry on from here.</p>'};
frame(); setInterval(()=>{ if(!busy && !document.hidden){busy=true; frame();} }, 2000);
</script>"""


# --- the browser ---------------------------------------------------------------

class Chrome:
    """Starts and restarts the profile browser."""

    def __init__(self, workspace=None, *, serve_ws=True):
        self.workspace = workspace
        self.serve_ws = serve_ws
        self.proc = None
        self.xvfb = None
        self.display = None
        self.vnc = None
        self.ws = None
        self.clip = browse.screen_size()

    def start(self) -> None:
        if browse.alive(self.workspace):
            return  # something (a session's `ensure`) already started one
        env = dict(os.environ)
        headed = bool(config.get("browser.headed", True)) and shutil.which("Xvfb")
        if headed:
            if self.xvfb is None or self.xvfb.poll() is not None:
                from herald import browser_workspaces as bw
                self.display = f":{bw.ports(self.workspace)['display']}" if self.workspace else f":{int(config.get('browser.display', 93))}"
                self.xvfb = subprocess.Popen(
                    ["Xvfb", self.display, "-screen", "0",
                     "{}x{}x24".format(*browse.display_max()), "-nolisten", "tcp"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                time.sleep(1)
            env["DISPLAY"] = self.display
        log = open(browse.home() / "chrome.log", "ab")
        self.proc = subprocess.Popen(browse.chrome_args(headless=not headed, workspace=self.workspace), env=env,
                                     stdout=log, stderr=log, stdin=subprocess.DEVNULL)
        for _ in range(60):
            if browse.alive(self.workspace):
                return
            time.sleep(0.25)

    def screen(self) -> None:
        """The live screen: x11vnc on the Xvfb display, websockify in front.

        Both bind to localhost. websockify also serves the noVNC page, and only
        a token written by `browse.new_view` gets a connection through it.
        """
        if not (self.display and browse.vnc_enabled()):
            return
        log = open(browse.home() / "screen.log", "ab")
        if self.vnc is None or self.vnc.poll() is not None:
            self.vnc = subprocess.Popen(
                ["x11vnc", "-display", self.display, "-rfbport", str(browse.vnc_port(self.workspace)),
                 "-localhost", "-nopw", "-forever", "-shared", "-quiet", "-noxdamage",
                 "-clip", "{}x{}+0+0".format(*self.clip)],
                stdout=log, stderr=log, stdin=subprocess.DEVNULL)
        if self.serve_ws and (self.ws is None or self.ws.poll() is not None):
            d = browse.vnc_dir()
            d.mkdir(parents=True, exist_ok=True)
            os.chmod(d, 0o700)
            self.ws = subprocess.Popen(
                ["websockify", "--web", str(browse.NOVNC_DIR),
                 "--token-plugin", "TokenFile", "--token-source", str(d),
                 f"127.0.0.1:{browse.ws_port()}"],
                stdout=log, stderr=log, stdin=subprocess.DEVNULL)

    def resize(self, w: int, h: int) -> None:
        """Share only a w x h corner of the display, sized to the viewer.

        x11vnc reads -clip once, so it is restarted; the noVNC page connects
        after this returns.
        """
        mw, mh = browse.display_max()
        self.clip = (max(480, min(w, mw)), max(480, min(h, mh)))
        if self.vnc is not None and self.vnc.poll() is None:
            self.vnc.terminate()
            try:
                self.vnc.wait(timeout=5)
            except Exception:
                self.vnc.kill()
        self.vnc = None
        self.screen()

    def watch(self) -> None:
        while True:
            if not browse.alive(self.workspace):
                self.start()
            self.screen()
            browse.prune_views()
            time.sleep(10)


# --- the view page -------------------------------------------------------------

def page(rec: dict, op: str, **more) -> dict:
    """Ask the daemon to do one thing to the tab a link is for."""
    r = browse_daemon.request({"cmd": "human", "op": op, "tab": rec["tab"],
                               "workspace": rec.get("workspace") or "default", "timeout": 30, **more},
                              timeout=45)
    if not r.get("ok"):
        raise LookupError(r.get("out") or "the tab is gone")
    return r


class Handler(BaseHTTPRequestHandler):
    server_version = "herald-browser"
    sys_version = ""

    def log_message(self, *args):  # nothing about a request is logged
        pass

    def _send(self, code: int, body: bytes, ctype: str = "text/html; charset=utf-8") -> None:
        self.send_response(code)
        for k, v in HEADERS.items():
            self.send_header(k, v)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _route(self):
        parts = self.path.split("?")[0].strip("/").split("/")
        if len(parts) < 2 or parts[0] != "v":
            return None, None, None
        token = parts[1]
        rec = browse.view(token)
        return token, rec, (parts[2] if len(parts) > 2 else "")

    def do_GET(self):
        token, rec, sub = self._route()
        if not rec:
            return self._send(404, b"not found", "text/plain")
        try:
            why = html.escape(f"Herald asked for this: {rec['why']}")
            if sub == "":
                return self._send(200, PAGE.replace("__WHY__", why).encode())
            if sub == "fit":
                mw, mh = browse.display_max()
                page_ = FIT.replace("__MAXW__", str(mw)).replace("__MAXH__", str(mh))
                return self._send(200, page_.encode())
            if sub == "live":
                page_ = LIVE.replace("__WHY__", why).replace("__VNC__", html.escape(browse.vnc_url(token)))
                return self._send(200, page_.encode())
            if sub == "frame":
                import base64
                return self._send(200, base64.b64decode(page(rec, "frame")["jpeg"]), "image/jpeg")
        except Exception as e:
            # The exception names the failure, never anything the user typed.
            print(f"view failed: {type(e).__name__}: {str(e)[:300]}", file=sys.stderr, flush=True)
            return self._send(502, b"the tab is gone", "text/plain")
        return self._send(404, b"not found", "text/plain")

    def _done(self, token, rec):
        browse.close_view(token)
        with db.session() as con:
            db.record_action(con, actor="user", tier="green", kind="browser.view",
                             target=rec["tab"],
                             summary="the user finished driving a browser tab "
                                     "(sign-in or similar); nothing they typed is kept")

    def do_POST(self):
        token, rec, sub = self._route()
        if rec and sub == "size":
            try:
                n = min(int(self.headers.get("Content-Length") or 0), 1024)
                a = json.loads(self.rfile.read(n) or b"{}")
                CHROME.resize(int(a["w"]), int(a["h"]))
                page(rec, "bounds", w=CHROME.clip[0], h=CHROME.clip[1])
                time.sleep(1.0)
                return self._send(200, b"ok", "text/plain")
            except Exception as e:
                print(f"resize failed: {type(e).__name__}: {str(e)[:200]}", file=sys.stderr, flush=True)
                try:
                    page(rec, "front")        # the wrong size is tolerable, the wrong tab is not
                except Exception:
                    pass
                return self._send(200, b"kept size", "text/plain")
        if not rec or sub != "act":
            return self._send(404, b"not found", "text/plain")
        try:
            n = min(int(self.headers.get("Content-Length") or 0), 8192)
            a = json.loads(self.rfile.read(n) or b"{}")
            k = a.get("k")
            if k == "done":
                self._done(token, rec)
                return self._send(200, b"ok", "text/plain")
            if k == "click":
                page(rec, "click", x=float(a["x"]), y=float(a["y"]))
            elif k == "type":
                page(rec, "type", text=str(a.get("text", ""))[:2000])
            elif k == "key" and a.get("key") in ("Enter", "Tab", "Backspace", "Escape"):
                page(rec, "key", key=a["key"])
            elif k == "scroll":
                page(rec, "scroll", dy=int(a.get("dy", 0)))
            elif k == "back":
                page(rec, "back")
            else:
                return self._send(400, b"unknown action", "text/plain")
            return self._send(200, b"ok", "text/plain")
        except Exception as e:
            print(f"action failed: {type(e).__name__}", file=sys.stderr, flush=True)
            return self._send(502, b"that did not work", "text/plain")


FIT = """<!doctype html><meta charset=utf-8>
<meta name=viewport content="width=device-width,initial-scale=1">
<title>Herald browser</title>
<body style="margin:0;background:#151515;color:#aaa;font:15px system-ui;display:grid;place-items:center;height:100vh">
<p>Sizing the browser to this window…</p>
<script>
// Measure the window this link was opened in and size the server's browser
// to match, so a laptop gets a laptop-sized page and a phone a phone-sized one.
// 52 pixels are kept for the bar with the Done button.
const w = Math.min(innerWidth, __MAXW__), h = Math.min(innerHeight - 52, __MAXH__);
fetch(location.pathname.replace(/fit\\/?$/, 'size'), {method: 'POST',
  headers: {'content-type': 'application/json'}, body: JSON.stringify({w, h})})
  .finally(() => location.replace(location.pathname.replace(/fit\\/?$/, 'live')));
</script>"""

# The live screen with a way to say "finished". Until 21 Nov 2026 a link into
# the default browser went through the review page to get this button, which
# reserved the whole browser while it was open.
LIVE = """<!doctype html><meta charset=utf-8>
<meta name=viewport content="width=device-width,initial-scale=1,maximum-scale=1">
<meta name=robots content=noindex><title>Herald browser</title>
<style>
html,body{margin:0;height:100%;background:#151515;color:#e8e8e8;font:14px -apple-system,system-ui,sans-serif}
body{display:flex;flex-direction:column}
#bar{height:52px;box-sizing:border-box;display:flex;gap:.6rem;align-items:center;padding:0 .6rem}
#why{flex:1;color:#aaa;font-size:13px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
button{font-size:15px;padding:.5rem .9rem;border:0;border-radius:6px;background:#e8e8e8;color:#151515}
iframe{flex:1;border:0;width:100%}
</style>
<div id=bar><div id=why>__WHY__</div><button id=done>Done</button></div>
<iframe id=live src="__VNC__" allow="clipboard-read; clipboard-write"></iframe>
<script>
const B = location.pathname.replace(/\\/live\\/?$/, '');
document.getElementById('done').onclick = async () => {
  await fetch(B + '/act', {method: 'POST', headers: {'content-type': 'application/json'}, body: '{"k":"done"}'});
  document.body.innerHTML = '<p style="padding:1rem">Done. Herald can carry on from here.</p>';
};
</script>"""

CHROME = None


def main() -> int:
    global CHROME
    browse.home().mkdir(parents=True, exist_ok=True)
    chrome = CHROME = Chrome()
    chrome.start()
    threading.Thread(target=chrome.watch, daemon=True).start()
    # Single-threaded on purpose: one person driving one tab does not need
    # concurrency, and each request is at most one short call to the daemon.
    srv = HTTPServer(("127.0.0.1", browse.view_port()), Handler)
    print(f"herald-browser: CDP {browse.cdp_url()}, view on 127.0.0.1:{browse.view_port()}",
          flush=True)
    srv.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
