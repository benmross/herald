    sess_p = sub.add_parser("session", help="one conversation's context and latency")
    sess_p.add_argument("session_id", nargs="?",
                        help="id or prefix (default: the most recent)")
    sess_p.set_defaults(fn=cmd_session)

    ay = sub.add_parser("apply", help="fill job applications from the answer bank (never submits)")
    ay_sub = ay.add_subparsers(dest="op", required=True)
    x = ay_sub.add_parser("fill", help="open each application and fill what the bank answers")
    x.add_argument("urls", nargs="+"); x.add_argument("--opp", type=int, help="opportunities.id")
    x.add_argument("--company")
    x.add_argument("--workspace"); x.add_argument("--retry", action="store_true")
    x = ay_sub.add_parser("refill", help="fill again (after new answers, or a lost tab)")
    x.add_argument("ids", nargs="*", type=int)
    x.add_argument("--workspace"); x.add_argument("--retry", action="store_true")
    x = ay_sub.add_parser("review", help="send a protected group of verified applications for your review")
    x.add_argument("ids", nargs="*", type=int); x.add_argument("--group")
    ay_sub.add_parser("pending", help="every unanswered question across open applications")
    x = ay_sub.add_parser("answer", help='store answers, then refill: JSON list of {"app","q","a","keep":app|bank|company,"pattern"}')
    x.add_argument("json", help="a file or a JSON string"); x.add_argument("--no-refill", action="store_true")
    x = ay_sub.add_parser("snapshot", help="save every field as it stands, so a refill restores it")
    x.add_argument("ids", nargs="*", type=int)
    ay_sub.add_parser("list", help="every application and its status")
    x = ay_sub.add_parser("mark", help="set a status by hand")
    x.add_argument("id", type=int)
    x.add_argument("status", choices=["filling", "filled", "submitted", "rejected", "closed", "withdrawn"])
    x.add_argument("--note")
    x = ay_sub.add_parser("code", help="newest verification code or link from the inbox")
    x.add_argument("--minutes", type=int, default=15); x.add_argument("--hint")
    x.add_argument("--wait", type=int, default=0)
    x = ay_sub.add_parser("packets", help="build or refresh application packets (the desk's data)")
    x.add_argument("ids", nargs="*", type=int, help="default: every open application")
    x.add_argument("--refresh", action="store_true", help="rebuild even approved or ready packets")
    x = ay_sub.add_parser("desk", help="send yourself the review desk link (revokes the old one)")
    x.add_argument("--print", action="store_true", help="print the link instead of sending it")
    ay_sub.add_parser("worker", help="fill approved packets one at a time (started by the desk)")
    x = ay_sub.add_parser("check", help="is a ready application's form still live? (JSON)")
    x.add_argument("id", type=int)
    x = ay_sub.add_parser("show", help="bring an application's tab to the front, opening it if needed")
    x.add_argument("id", type=int)
    x = ay_sub.add_parser("close", help="close a submitted application's tab")
    x.add_argument("id", type=int)
    ay.set_defaults(fn=cmd_apply)

    wt = sub.add_parser("watch", help="recheck a page until an opportunity opens")
    wt_sub = wt.add_subparsers(dest="op")
    wt_sub.add_parser("list", help="what is watched, and whether it has opened")
    x = wt_sub.add_parser("add", help="watch a page for one opportunity row")
    x.add_argument("id", type=int, help="opportunities.id")
    x.add_argument("url")
    x.add_argument("--for", dest="pattern",
                   help="regex the page will match once it is open; without it, any change is noted")
    x.add_argument("--now", action="store_true", help="check it once right away")
    x = wt_sub.add_parser("rm", help="stop watching"); x.add_argument("id", type=int)
    x = wt_sub.add_parser("check", help="check now rather than on the timer")
    x.add_argument("id", type=int, nargs="?")
    wt.set_defaults(fn=cmd_watch, op="list")

    bw = sub.add_parser("browse", help="a real browser on this machine: read, fill, crawl")
    bw.add_argument("--workspace", help="independent browser workspace")
    bw_sub = bw.add_subparsers(dest="op", required=True)
    bw_sub.add_parser("workspaces", help="list durable browser ownership")
    x = bw_sub.add_parser("workspace", help="register a separate browser workspace")
    x.add_argument("name", nargs="?")
    bw_sub.add_parser("status", help="is the profile browser up, and where")
    bw_sub.add_parser("tabs", help="open tabs, with their ids")
    x = bw_sub.add_parser("fetch", help="render one public page headless and print its text")
    x.add_argument("url"); x.add_argument("--wait", type=int, default=5000)
    x.add_argument("--max", type=int, default=20000)
    x = bw_sub.add_parser("open", help="open a URL in a new tab of the profile browser")
    x.add_argument("url"); x.add_argument("--wait", type=int, default=4000)
    x = bw_sub.add_parser("go", help="navigate a tab"); x.add_argument("tab"); x.add_argument("url")
    x.add_argument("--wait", type=int, default=4000)
    x = bw_sub.add_parser("close", help="close a tab"); x.add_argument("tab")
    x = bw_sub.add_parser("text", help="a tab's visible text, frames included")
    x.add_argument("tab"); x.add_argument("--selector", default="body")
    x.add_argument("--max", type=int, default=12000); x.add_argument("--offset", type=int, default=0)
    x = bw_sub.add_parser("links", help="a tab's links, label<TAB>href")
    x.add_argument("tab"); x.add_argument("--match", help="regex on label or href")
    x = bw_sub.add_parser("fields", help="form fields with handles to fill, and the buttons")
    x.add_argument("tab")
    for name, h in (("fill", "type a value"), ("select", "choose an option by its label"),
                    ("check", "tick (or 'off' to untick)"), ("upload", "attach a file path")):
        x = bw_sub.add_parser(name, help=h + " into a field (handle from `fields`, or a selector)")
        x.add_argument("tab"); x.add_argument("field"); x.add_argument("value")
    x = bw_sub.add_parser("click", help="click a button, link or text; refuses final submits")
    x.add_argument("tab"); x.add_argument("target"); x.add_argument("--wait", type=int, default=2500)
    x = bw_sub.add_parser("press", help="press a key (Enter, Tab, Escape...)")
    x.add_argument("tab"); x.add_argument("key"); x.add_argument("--wait", type=int, default=2000)
    x = bw_sub.add_parser("scroll", help="scroll a tab"); x.add_argument("tab")
    x.add_argument("dy", type=int, nargs="?", default=900)
    x = bw_sub.add_parser("shot", help="screenshot a tab to a PNG (Read it to see the page)")
    x.add_argument("tab"); x.add_argument("path", nargs="?"); x.add_argument("--full", action="store_true")
    x = bw_sub.add_parser("html", help="a tab's HTML, or one element's")
    x.add_argument("tab"); x.add_argument("--selector", default="html")
    x.add_argument("--max", type=int, default=30000)
    x = bw_sub.add_parser("login", help="send the user a link to drive a tab themselves (sign-ins)")
    x.add_argument("tab"); x.add_argument("--why", required=True)
    x.add_argument("--minutes", type=int, default=30)
    x = bw_sub.add_parser("crawl", help="read many pages in parallel, headless, resumable")
    x.add_argument("urls", help="file: one URL, or id<TAB>URL, per line")
    x.add_argument("--out", required=True, help="directory; one <id>.txt per page")
    x.add_argument("--concurrency", type=int, default=6)
    x.add_argument("--wait", type=int, default=5000, help="ms to let each page render")
    x.add_argument("--grep", help="regex; matching lines go to <out>/matches.jsonl")
    x.add_argument("--profile", action="store_true",
                   help="use the signed-in profile browser instead of a clean one")
    x.add_argument("--every", type=int, default=25, help="print progress every N pages")
    x.add_argument("--links", action="store_true", help="also write <id>.links.tsv (label<TAB>href) per page")
    bw.set_defaults(fn=cmd_browse)

    n = sub.add_parser("notify", help="push to the user's phone")
    n.add_argument("title")
    n.add_argument("body", nargs="?", default="")
    n.add_argument("--file", help="send this file to Telegram as a document; "
                   "title and body become its caption")
    n.add_argument("--priority", default="default")
    n.add_argument("--tags")
    n.add_argument("--click")
    n.set_defaults(fn=cmd_notify)

    b = sub.add_parser("brain", help="the persistent conversational session")
    b.add_argument("action", nargs="?", default="status",
                   choices=["start", "stop", "ensure", "status", "url"])
    b.set_defaults(fn=cmd_brain)

    a = sub.add_parser("attach", help="terminal conversation with your chosen provider")
    a.add_argument("--engine", choices=list(config.ENGINE_NAMES))
    a.set_defaults(fn=cmd_attach)

    c = sub.add_parser("collect", help="run collectors that are due")
    c.add_argument("names", nargs="*",
                   help="run these regardless of cadence; omit to run what is due")
    c.add_argument("--force", action="store_true",
                   help="run everything, ignoring cadence")
    c.add_argument("--reconcile", action="store_true",
                   help="audit and recover historical gaps for explicit gmail/gcal sources")
    c.set_defaults(fn=cmd_collect)

    md = sub.add_parser("mode", help="tracking, fork, or maintainer")
    md.add_argument("mode", nargs="?", choices=list(upstream.MODES))
    md.set_defaults(fn=cmd_mode)

    up = sub.add_parser("update", help="fast-forward to the newest release")
    up.add_argument("--check", action="store_true",
                    help="say what is available and stop")
    up.set_defaults(fn=cmd_update)

    rl = sub.add_parser("release", help="cut a release other installs will take")
    rl.add_argument("--preview", action="store_true", help="say what it would ship")
    rl.add_argument("--minor", action="store_true")
    rl.add_argument("--major", action="store_true")
    rl.set_defaults(fn=cmd_release)

    sv = sub.add_parser("services", help="the background jobs")
    sv.add_argument("action", nargs="?", default="install",
                    choices=["install", "enable", "status"])
    sv.add_argument("--force", action="store_true",
                    help="install over units belonging to another checkout")
    sv.set_defaults(fn=cmd_services)

    su = sub.add_parser("setup", help="set Herald up, or fix one part of it")
    su.add_argument("--step", help="run one step on its own")
    su.add_argument("--list", action="store_true", help="what is set up so far")
    su.add_argument("--web", action="store_true", help="use the browser wizard")
    su.add_argument("--port", type=int, default=8799)
    su.set_defaults(fn=cmd_setup)

    cn = sub.add_parser("constitution",
                        help="rebuild CLAUDE.md from the shared and personal rules")
    cn.add_argument("--check", action="store_true", help="only say whether it is current")
    cn.set_defaults(fn=cmd_constitution)

    cf = sub.add_parser("config", help="read or write one setting")
    cf.add_argument("action", choices=["get", "set", "path"])
    cf.add_argument("path", nargs="?")
    cf.add_argument("value", nargs="?")
    cf.set_defaults(fn=cmd_config)

    ts = sub.add_parser("test", help="the offline suite, program and extensions")
    ts.add_argument("extra", nargs="*", help="passed through to unittest")
    ts.set_defaults(fn=cmd_test)

    e = sub.add_parser("ext", help="extensions: personal collectors, cycles and skills")
    e.add_argument("action", nargs="?", default="list",
                   choices=["list", "new", "enable", "disable", "sync",
                            "install", "update", "check", "setup"])
    e.add_argument("name", nargs="?",
                   help="an extension's name; for install, its git URL")
    e.add_argument("--enable", action="store_true",
                   help="install: turn it on straight away rather than leaving it off")
    e.add_argument("--json", action="store_true",
                   help="setup: print the unanswered questions as JSON, for a session to ask")
    e.set_defaults(fn=cmd_ext)

    y = sub.add_parser("cycle", help="run one cycle")
    y.add_argument("name")
    y.set_defaults(fn=cmd_cycle)

    args = p.parse_args()
    if private_mod.active() and not _reads_only(args):
        print(f"`herald {args.cmd}` is not available in a private session, which "
              f"can read and cannot save or change anything.", file=sys.stderr)
        return 2
    config.ensure_dirs()
    # Tracking is the default before anyone has chosen anything, and the
    # wizard's updates step can now be skipped -- so the guard that makes
    # tracking mean something is put in place by whichever `herald` command
    # runs first, rather than depending on one particular screen having been
    # seen. Cheap: a stat of one file.
    if upstream.is_tracking() and not upstream.hook_installed():
        try:
            upstream.install_hook()
        except (OSError, FileExistsError):
            pass
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
