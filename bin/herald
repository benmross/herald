                        help="seconds to wait for a tap (red kinds)")
    common.add_argument("--telegram-thread", type=int, default=None,
                        help="forum topic to ask in (default: the topic of the Telegram turn asking, else Updates)")
    up = act_sub.add_parser("drive-upload", parents=[common],
