    pu.add_argument("--no-download", action="store_true", help="rebuild from extracts already here")
    pn = pl_sub.add_parser("near", help="places near a point, a place name or an address")
    pn.add_argument("where", help='"lat,lon", a name in the index, or an address')
    pn.add_argument("--radius", type=float, default=1000, help="metres (default 1000)")
    pn.add_argument("--kind", default=",".join(("restaurant", "fast_food", "cafe", "food_court", "pub", "bar")),
                    help="comma list of amenity/shop values, or 'any'")
    pn.add_argument("--cuisine")
    pn.add_argument("--open-at", help="'now' or ISO local time, e.g. 2026-10-23T21:45")
    pn.add_argument("--open-for", type=int, default=0, help="must still be open this many minutes later")
    pn.add_argument("--known-only", action="store_true", help="drop places whose hours OSM does not give")
    pn.add_argument("--limit", type=int, default=200)
    pn.add_argument("--json", action="store_true")
    pg = pl_sub.add_parser("get", help="every tag of places whose name matches")
    pg.add_argument("name")
    pg.add_argument("--limit", type=int, default=5)
    pl.set_defaults(fn=cmd_places)

    fd = sub.add_parser(
        "find", help="locate, minus what has gone since the index",
        description="Search the nightly locate index, drop results that no longer exist, "
                    "and optionally search some directories live for anything newer.")
    fd.add_argument("patterns", nargs="+", help="every one must match (substring, or regex with -r)")
    fd.add_argument("-i", "--ignore-case", action="store_true")
    fd.add_argument("-r", "--regex", action="store_true")
    fd.add_argument("-b", "--basename", action="store_true", help="match the name only, not the whole path")
    fd.add_argument("-l", "--limit", type=int)
    fd.add_argument("-c", "--count", action="store_true")
    fd.add_argument("-0", "--null", action="store_true", help="NUL-separated, for xargs -0")
    fd.add_argument("--in", dest="fresh", action="append", default=[], metavar="DIR",
                    help="also search DIR live, for names newer than the index (repeatable)")
    fd.add_argument("-q", "--quiet", action="store_true", help="no note about the index on stderr")
    fd.set_defaults(fn=cmd_find)

    pr = sub.add_parser(
        "prose", help="find the stock patterns of machine-written prose in a text",
        description="Lint files (or stdin) the way the Stop hook lints a reply. "
                    "Exits 1 if anything would have been sent back for a rewrite.")
    pr.add_argument("files", nargs="*", help="files to read; - or nothing for stdin")
    pr.add_argument("--rules", action="store_true", help="list the rules and stop")
    pr.add_argument("--stats", action="store_true",
                    help="what the hook has flagged so far, by rule")
    pr.add_argument("-l", "--limit", type=int, default=40, help="hits to show per file")
    pr.set_defaults(fn=cmd_prose)

    am = sub.add_parser("amber", help="a reversible change only the user sees, logged")
    am_sub = am.add_subparsers(dest="kind", required=True)
    amc = argparse.ArgumentParser(add_help=False)
    amc.add_argument("--actor", default=os.environ.get("HERALD_ACTOR", "session"),
                     help="who is acting, for the audit row (default: $HERALD_ACTOR, "
                          "which a cycle sets, else session)")
    f = am_sub.add_parser("find", help="read: one day of one of the user's calendars")
    f.add_argument("--calendar", required=True)
    f.add_argument("--day", required=True, help="YYYY-MM-DD")
    for kind, text in (("update", "change an event's title, place, time or notes"),
                       ("cancel", "retitle CANCELLED and grey; never deletes")):
        k = am_sub.add_parser(kind, parents=[amc], help=text)
        k.add_argument("--calendar", required=True)
        k.add_argument("--event", required=True,
                       help="Google event id, or a gcal fact's external_id")
        k.add_argument("--why", required=True, help="the source, with its fact id")
        if kind == "update":
            for opt in ("--summary", "--location", "--start", "--end", "--description"):
                k.add_argument(opt)
    c = am_sub.add_parser("create", parents=[amc], help="add an event, skipping duplicates")
    c.add_argument("--calendar", required=True)
    c.add_argument("--summary", required=True)
    c.add_argument("--start", required=True, help="ISO datetime, or YYYY-MM-DD for all day")
    c.add_argument("--end")
    c.add_argument("--location")
    c.add_argument("--description")
    c.add_argument("--why", required=True)
    t = am_sub.add_parser("task", parents=[amc], help="add a Google Task")
    t.add_argument("--title", required=True)
    t.add_argument("--due")
    t.add_argument("--list")
    t.add_argument("--why", required=True)
    am.set_defaults(fn=cmd_amber)

    ori = sub.add_parser("orient",
                         help="rebuild state/orientation.md, the session card")
    ori.add_argument("--show", action="store_true", help="print it too")
    ori.set_defaults(fn=cmd_orient)

    lat = sub.add_parser("latency", help="where a turn's wall clock actually goes")
    lat.add_argument("--days", type=int, default=7, help="window (default 7)")
    lat.add_argument("--run", type=int, help="show one run's phase timeline")
    lat.add_argument("--transcripts", action="store_true",
                     help="reconstruct from Claude Code session files, for "
                          "turns older than the instrumentation")
    lat.set_defaults(fn=cmd_latency)
    sub.add_parser("check", help="do the architecture's invariants still hold").set_defaults(fn=cmd_check)

    rs = sub.add_parser("restart", help="check, then restart services")
    rs.add_argument("units", nargs="*",
                    help="default: herald-telegram and herald-brain")
    rs.add_argument("--defer", action="store_true",
                    help="request a restart instead of doing one now -- safe "
                         "mid-turn; see cmd_restart's docstring")
    rs.add_argument("--reason", help="why, for whoever reads the request later")
    rs.add_argument("--force", action="store_true",
                    help="restart even while a Telegram topic is mid-turn, "
                         "killing it -- see cmd_restart")
    rs.set_defaults(fn=cmd_restart)

    t = sub.add_parser("think", help="one metered agent invocation")
    t.add_argument("prompt", nargs="?")
