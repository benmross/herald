#!/usr/bin/env python3
"""herald: the one command.

    herald status                  what's running, what it cost, what's stale
    herald doctor                  check the things that silently break
    herald think "..."             one metered agent invocation
    herald db "select ..."         query the ledger
    herald notify "title" "body"   push to the user's phone
    herald check                   do the architecture's invariants still hold
    herald restart [unit ...]      check, then restart
    herald brain [start|stop|status|url]
    herald attach                  attach to the brain's terminal
    herald collect [name ...]      run collectors
    herald cycle <name>            run one cycle end to end
    herald setup                   set it up, or fix one part of it
    herald ext                     personal collectors, cycles and skills
    herald find PATTERN...         locate, minus what has gone since the index
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import pathlib
import re
import shutil
import sqlite3
import subprocess
import sys
import textwrap
import time

ROOT = pathlib.Path(__file__).resolve().parents[1]

# Re-exec into the project venv if we are not already in it. Anything that
# touches Google needs googleapiclient, and the system interpreter does not
# have it; the failure mode otherwise is an ImportError out of a systemd timer
# at 06:30.
#
# The test is sys.prefix, not the interpreter path. `venv/bin/python` is a
# symlink chain ending at /usr/bin/python3, so resolving it and comparing to
# sys.executable said "already in the venv" while running under the system
# interpreter with none of the venv's packages -- silently, because everything
# that needed them ran as a subprocess through config.python() rather than
# in-process. The first in-process import of googleapiclient (the setup
# wizard's Google step) is what finally surfaced it.
_VENV_PY = ROOT / "venv" / "bin" / "python"
if _VENV_PY.exists() and pathlib.Path(sys.prefix).resolve() != (ROOT / "venv").resolve():
    _self = str(pathlib.Path(__file__).resolve())
    os.execv(str(_VENV_PY), [str(_VENV_PY), _self, *sys.argv[1:]])

sys.path.insert(0, str(ROOT / "lib"))

from herald import (activity, capabilities, config,  # noqa: E402
                    constitution as constitution_mod, db, extensions,
                    migrations as migrations_mod, notify,
                    think as think_mod, upstream)
from herald import context as context_mod, factview, search as search_mod, sessioninfo  # noqa: E402
from herald import private as private_mod  # noqa: E402

BOLD, DIM, OFF = "\033[1m", "\033[2m", "\033[0m"
OK, WARN, BAD = "\033[32m", "\033[33m", "\033[31m"


def _c(s: str, colour: str) -> str:
    return s if not sys.stdout.isatty() else f"{colour}{s}{OFF}"


def _hdr(s: str) -> None:
    print(f"\n{_c(s, BOLD)}")


# --------------------------------------------------------------------------- status

def cmd_status(args) -> int:
    cfg = config.load()
    print(f"{_c('herald', BOLD)} {_c('· ' + cfg['name'], DIM)}  "
          f"{os.uname().nodename}  {config.ROOT}")

    _hdr("engines")
    default_engine = config.get("engines.default_engine")
    for engine in config.enabled_engines():
        block = f"engines.{engine}"
        cmd = config.get(f"{block}.cmd", engine)
        path = shutil.which(cmd, path=config.agent_env()["PATH"])
        tag = " (default)" if engine == default_engine else ""
        if path:
            try:
                ver = subprocess.run([path, "--version"], capture_output=True,
                                     text=True, timeout=15).stdout.strip().splitlines()[0]
            except Exception:
                ver = "?"
            print(f"  {engine:9} {_c('ok', OK)}   {cmd:7} {ver}{tag}")
        else:
            print(f"  {engine:9} {_c('MISSING', BAD)}  {cmd}{tag}; "
                  "run `herald setup --step preflight` for install instructions")

    _hdr("spend  (client-side estimate, not your bill)")
    rows = db.query("""
        SELECT label,
               COUNT(*)                          AS runs,
               ROUND(SUM(COALESCE(cost_usd,0)),4) AS usd
        FROM runs WHERE ts >= datetime('now','-7 days')
        GROUP BY label ORDER BY usd DESC LIMIT 12
    """)
    if not rows:
        print(f"  {_c('no runs recorded yet', DIM)}")
    else:
        print(f"  {'label':<28}{'runs':>6}{'usd':>10}")
        for r in rows:
            print(f"  {r['label']:<28}{r['runs']:>6}{r['usd'] or 0:>10.4f}")
        tot = db.query("SELECT ROUND(SUM(COALESCE(cost_usd,0)),4) t,"
                       " COUNT(*) n FROM runs WHERE ts >= datetime('now','-7 days')")[0]
        print(f"  {_c(f'{tot['n']} runs / ${tot['t'] or 0:.4f} in the last 7 days', DIM)}")

    _hdr("program")
    current_mode = upstream.mode()
    release = upstream.current_release()
    print(f"  {'mode':16} {current_mode}")
    print(f"  {'version':16} {upstream.version()}"
          f"{'  (' + release + ')' if release else '  (no release tag yet)'}")
    if current_mode == "maintainer":
        waiting = upstream.unreleased()
        if waiting:
            print(f"  {'unreleased':16} {_c(str(len(waiting)) + ' commit(s)', WARN)}"
                  f". `herald release --preview`")
    elif current_mode == "tracking":
        if not upstream.hook_installed():
            print(f"  {'commit hook':16} {_c('missing', WARN)}. Run `herald mode tracking`")
        local = upstream.local_changes()
        if local["modified"] or local["commits"]:
            note = (f"{len(local['modified'])} edited, "
                    f"{len(local['commits'])} committed")
            print(f"  {'local changes':16} {_c(note, BAD)}"
                  f", so updates cannot be applied")

    exts = extensions.all_extensions()
    if exts:
        _hdr("extensions")
        for ext in exts:
            state = _c("on ", OK) if ext.enabled else _c("off", DIM)
            print(f"  {state} {ext.name:14} {ext.description[:60]}")

    _hdr("capabilities")
    for key, cap in sorted(capabilities.registry().items()):
        why = capabilities.missing(key)
        where = f" ({cap.extension})" if cap.extension else ""
        if why is None:
            print(f"  {key:16} {_c('on', OK)}{where}")
        elif why == "not enabled":
            print(f"  {key:16} {_c('off', DIM)}{where}")
        else:
            print(f"  {key:16} {_c('needs setup', WARN)}{where}  {why}")

    _hdr("collectors")
    rows = db.query("SELECT * FROM collector_state ORDER BY collector")
    if not rows:
        print(f"  {_c('none registered yet', DIM)}")
    # Cycles keep cursors in this table too (scout's seen set, the bridge's
    # offset), and a retired collector leaves its row behind. Both would
    # otherwise read as live collectors that have stopped running.
    live = set(_discover("collectors"))
    for r in rows:
        fails = r["consecutive_failures"]
        if r["collector"] not in live:
            state = _c("not a collector", DIM)
        elif fails:
            state = _c(f"failing x{fails}", BAD if fails > 2 else WARN)
        elif r['sync_status'] == 'partial':
            state = _c(f"partial ({r['pending_retries']} retries)", WARN)
        elif r['sync_status'] == 'unknown':
            state = _c("coverage unknown", WARN)
        else:
            state = _c("ok", OK)
        print(f"  {r['collector']:<20} {state:<22} "
              f"last complete {r['last_complete'] or 'not established'}")

    _hdr("ledger")
    facts = db.query("SELECT source, kind, COUNT(*) n, MAX(ts) latest"
                     " FROM facts GROUP BY source, kind ORDER BY n DESC LIMIT 10")
    if not facts:
        print(f"  {_c('empty: nothing has been read yet', DIM)}")
    for f in facts:
        print(f"  {f['source'] + '/' + f['kind']:<28}{f['n']:>7}  latest {f['latest'] or '-'}")

    openc = db.query("SELECT COUNT(*) n FROM commitments WHERE status='open'")[0]["n"]
    print(f"  {'open commitments':<28}{openc:>7}")

    if config.DB_PATH.exists():
        print(f"  {_c(f'facts.db {config.DB_PATH.stat().st_size / 1e6:.1f} MB', DIM)}")
    return 0


# --------------------------------------------------------------------------- doctor

def cmd_usage(args) -> int:
    """Subscription percentages, distinct from the local token/cost ledger."""
    from herald import usage
    with db.session() as con:
        text, failed = usage.report(con, [args.engine] if args.engine else None,
                                    force=args.refresh, cached_only=args.cached)
    print(text)
    return int(failed)


def cmd_doctor(args) -> int:
    problems = 0

    def check(name: str, ok: bool, detail: str = "") -> None:
        nonlocal problems
        if not ok:
            problems += 1
        mark = _c("PASS", OK) if ok else _c("FAIL", BAD)
        print(f"  {mark}  {name}{('  ' + detail) if detail else ''}")

    _hdr("paths")
    print(f"        {_c('program  ' + str(config.ROOT), DIM)}")
    print(f"        {_c('home     ' + str(config.HOME)
                        + ('  (pre-split layout)' if config.LEGACY_LAYOUT else ''), DIM)}")
    for p in (config.CONFIG_PATH, config.LEDGER, config.IDENTITY, config.STATE):
        try:
            label = str(p.relative_to(config.HOME))
        except ValueError:
            label = str(p)
        check(label, p.exists())

    _hdr("credentials")
    env = config.agent_env()
    check("no engine API key leaking into agent env",
          not any(k in env for k in ("ANTHROPIC_API_KEY", "OPENAI_API_KEY", "CODEX_API_KEY")),
          "an API key would silently move Herald onto metered billing")
    sys.path.insert(0, str(config.ROOT))
    from setup.preflight import provider_checks  # noqa: PLC0415
    for row in provider_checks():
        check(row["name"], row["ok"], row["detail"] if row["ok"] else row["fix"])
    from herald import google as google_mod  # noqa: PLC0415
    check("google token", google_mod.available(),
          f"expected in {google_mod.credentials_dir()}. Run `herald setup --step google`")

    from herald import rootcmd  # noqa: PLC0415
    if rootcmd.installed():
        _hdr("root approvals")
        check("herald-root running", rootcmd.active(),
              "journalctl -u herald-root -n 50")
        check("installed daemon matches this checkout", rootcmd.current(),
              "run `herald root update` (it asks for sudo)")

    _hdr("database")
    try:
        with db.session() as con:
            tables = {r[0] for r in con.execute(
                "SELECT name FROM sqlite_master WHERE type='table'")}
        for t in ("facts", "runs", "commitments", "collector_state", "notifications"):
            check(f"table {t}", t in tables)
    except Exception as e:
        check("open facts.db", False, str(e))

    print()
    if problems:
        print(_c(f"{problems} problem(s)", BAD))
    else:
        print(_c("all good", OK))
    return 1 if problems else 0


# --------------------------------------------------------------------------- think

def cmd_check(args) -> int:
    """Do the architecture's invariants still hold? Run before restarting."""
    return subprocess.run([config.python(), str(config.ROOT / "tools" / "check.py")],
                          cwd=str(config.ROOT), env=_child_env()).returncode


def cmd_restart(args) -> int:
    """Check first, then restart. Refuses on a failing check.

    `--defer` writes a restart request instead of restarting immediately, and
    returns right away -- safe to call from inside a live turn, unlike a bare
    restart. Restarting herald-telegram.service from the subprocess handling
    the very message you're replying to kills the process that was going to
    deliver that reply, and there is no way to tell from inside that
    subprocess whether some *other* Telegram topic is also mid-turn right
    now. `bin/herald-telegram`'s own main loop is what actually acts on a
    deferred request, once its activity registry is empty -- see
    lib/herald/activity.py.

    herald-brain has no equivalent idle signal -- it's one continuous `claude
    remote-control` session in a tmux pane, not a subprocess per turn, so
    there is no hook to know when it is safe. `--defer` therefore only ever
    covers herald-telegram.service; anything else stays untouched and gets
    reported as skipped rather than restarted blind, which would reintroduce
    the exact bug this exists to prevent, just for the other surface.
    """
    if cmd_check(args) != 0:
        print(_c("\nnot restarting: fix the failures above first", BAD),
              file=sys.stderr)
        return 1
    units = args.units or ["herald-telegram.service", "herald-brain.service"]

    if getattr(args, "defer", False):
        deferrable = [u for u in units if u == "herald-telegram.service"]
        skipped = [u for u in units if u != "herald-telegram.service"]
        if deferrable:
            activity.request_restart(deferrable, args.reason or "requested")
            print(f"  requested: {', '.join(deferrable)} "
                  f"(will restart once no Telegram topic is mid-turn)")
        for u in skipped:
            print(f"  skipped {u}: no idle signal for this surface -- "
                  f"restart it by hand (`herald restart {u}`) when nothing "
                  f"is using it")
        return 0

    # The docstring above has always described this failure. Describing it was
    # not enough: on 9 Sep 2026 a session fixed bin/herald-telegram, committed,
    # and ran a bare `herald restart` to load its own fix. herald-telegram is
    # the first unit in the default list, so systemd stopped the very process
    # running that command -- killing its own reply mid-sentence and, as
    # collateral, an unrelated fable turn that had been working for 17 minutes
    # in another topic. The loop never reached the second unit. So the rule is
    # enforced here rather than merely documented: if any topic is mid-turn,
    # a non-deferred restart of the bridge is refused, because `--defer` does
    # exactly this correctly and costs nothing but a wait.
    live = [t for t in activity.active() if t.get("service") == "telegram"]
    if live and "herald-telegram.service" in units and not getattr(args, "force", False):
        print(_c(f"\nnot restarting: {len(live)} Telegram topic(s) mid-turn",
                 BAD), file=sys.stderr)
        for t in live:
            age = int(time.time() - (t.get("started") or time.time()))
            print(f"    {t.get('key')} ({age}s in)", file=sys.stderr)
        print("\n  Restarting herald-telegram now kills those turns, and if you\n"
              "  are one of them it kills the reply you are writing. Use:\n"
              "      herald restart --defer\n"
              "  which restarts as soon as no topic is mid-turn. `--force`\n"
              "  overrides this, and should be a decision, not a reflex.",
              file=sys.stderr)
        return 1

    sys.path.insert(0, str(config.ROOT))
    from setup import services  # noqa: PLC0415
    rc = 0
    for u in units:
        ok, err = services.restart(u)
        rc = rc or (0 if ok else 1)
        print(f"  restarted {u}" if ok else f"  FAILED {u}  {err}")
    return rc


def cmd_think(args) -> int:
    prompt = args.prompt or sys.stdin.read()
    if not prompt.strip():
        print("nothing to think about", file=sys.stderr)
        return 2
    try:
        # One question, so the private session begins and ends here: its
        # scratch directory is deleted whatever the run came to.
        scratch = private_mod.new_scratch() if args.private else None
        try:
            r = think_mod.think(prompt, label=args.label,
                                model=args.model, cwd=args.cwd,
                                engine=args.engine, effort=args.effort,
                                private=scratch)
        finally:
            if scratch is not None:
                private_mod.destroy(scratch)
    except (ValueError, private_mod.Refused) as exc:  # no such engine or level, or no sandbox
        print(str(exc), file=sys.stderr)
        return 2
    if not r.ok:
        print(r.error or "failed", file=sys.stderr)
        return 1
    print(r.text)
    if args.verbose:
        note = f"{r.engine}/{r.model or 'default'} {r.duration_ms}ms"
        if r.cost_usd is not None:
            note += f" ${r.cost_usd:.4f}"
        print(_c(note, DIM), file=sys.stderr)
    return 0


# --------------------------------------------------------------------------- db

SCHEMA_HELP = """\
The ledger is one SQLite file at ledger/facts.db. There is no sqlite3 CLI on
this machine -- use `herald db` or Python. Do not go looking for one.

TABLES
  facts          everything ingested. source + kind + external_id + ts
                 + title + body + data(JSON) + ingested_at
  opportunities  things to apply for, with a lifecycle
  commitments    open loops
  runs           every agent invocation and what it cost
  collector_state, notifications

REACHING INTO data
  json_extract(data, '$.field')      -- use this, not LIKE on the JSON text

WHAT IS IN facts  (source/kind, and the fields worth knowing)
"""


def cmd_db(args) -> int:
    if args.schema:
        print(SCHEMA_HELP)
        rows = db.query("""
            SELECT source, kind, COUNT(*) n, MAX(ts) latest
            FROM facts GROUP BY source, kind ORDER BY source, n DESC
        """)
        for r in rows:
            print(f"  {r['source'] + '/' + r['kind']:<26}{r['n']:>7}  latest {r['latest'] or '-'}")
        print("\n  People are matched on facts.title, which holds the contact"
              " name as the address book has it -- a full name, not a"
              " nickname.\n")
        for t in ("opportunities", "commitments"):
            cols = [c["name"] for c in db.query(f"PRAGMA table_info({t})")]
            print(f"  {t}: {', '.join(cols)}")
        return 0
    rows = db.query(args.sql)
    if args.json:
        print(json.dumps([dict(r) for r in rows], indent=2, default=str))
        return 0
    # No colour and no silent cut. The reader is almost always a session, and a
    # value shortened without a pointer to the rest costs it a round trip to
    # go and find the rest. lib/herald/factview.py has the whole story.
    print(factview.render(rows, budget=args.budget, spill_dir=_spill_dir()))
    return 0


def _spill_dir() -> pathlib.Path:
    """Where a value too big for one tool result is written whole. Under `raw/`,
    which is gitignored and disposable: it is a view of facts.db, not memory."""
    return config.LEDGER / "raw" / "view"


def cmd_fact(args) -> int:
    """One or more facts, every column whole.

    The reference half of working from originals: the delta, a digest or a
    query names a fact by id, and this is the one call that shows all of it.
    Several ids go in one call, because every separate call is another model
    round trip.
    """
    refs = args.ref
    if len(refs) == 2 and not refs[0].isdigit():
        rows = db.query("SELECT * FROM facts WHERE source = ? AND external_id = ? "
                        "ORDER BY id", refs)
    elif all(r.isdigit() for r in refs):
        rows = db.query(f"SELECT * FROM facts WHERE id IN ({','.join('?' * len(refs))}) "
                        "ORDER BY id", [int(r) for r in refs])
    else:
        print("usage: herald fact <id> [<id> ...]   or   herald fact <source> <external_id>",
              file=sys.stderr)
        return 2
    if not rows:
        print("(no such fact)")
        return 1
    print(factview.render(rows, budget=args.budget, spill_dir=_spill_dir()))
    return 0


def _quiz_topic(explicit: str | None) -> tuple[int, int | None] | None:
    """Where a quiz goes: `--topic chat:thread`, else the Telegram topic whose
    turn is running right now -- the one that asked for it."""
    key = explicit
    if not key:
        live = [t["key"] for t in activity.active() if t.get("service") == "telegram"]
        if len(live) != 1:
            return None
        key = live[0]
    chat, _, thread = key.partition(":")
    return int(chat), (int(thread) if thread and thread != "main" else None)


def cmd_quiz(args) -> int:
    """A quiz set, delivered on Telegram and checked without a model. See
    lib/herald/study.py and skills/herald-study."""
    from herald import notify, study  # noqa: PLC0415
    if args.action == "status":
        rows = db.query("SELECT id, created, title, state, pos, summary FROM study_sets "
                        "ORDER BY id DESC LIMIT 10")
        for r in rows:
            print(f"#{r['id']}  {r['created'][:16]}  {r['state']:<9} {r['title']}"
                  f"  {r['summary'] or 'at Q' + str(r['pos'] + 1)}")
        return 0
    topic = _quiz_topic(args.topic)
    if topic is None:
        print("which topic? pass --topic <chat_id>:<thread_id|main> (no single "
              "Telegram turn is running to infer it from)", file=sys.stderr)
        return 1
    chat, thread = topic
    with db.session() as con:
        if args.action == "stop":
            row = study.active_for(con, chat, thread)
            if not row:
                print("no live quiz in that topic")
                return 0
            con.execute("UPDATE study_sets SET state = 'abandoned', finished = ? "
                        "WHERE id = ?", (db.now(), row["id"]))
            print(f"stopped #{row['id']}")
            return 0
        if not args.file:
            print("start needs a set file", file=sys.stderr)
            return 1
        try:
            spec = json.loads(pathlib.Path(args.file).read_text())
            sid = study.create(con, spec, chat, thread)
        except (OSError, json.JSONDecodeError, study.SetError) as e:
            print(f"not started: {e}", file=sys.stderr)
            return 1
        study.start(notify._telegram_api, con, sid)
    print(f"quiz #{sid} started in {chat}:{thread or 'main'}, "
          f"{len(spec['items'])} items")
    return 0


def cmd_session(args) -> int:
    """Context and latency for one conversation; see lib/herald/sessioninfo.py.
    The same report the Telegram bridge sends for /debug."""
    with db.session() as con:
        sid = args.session_id or sessioninfo.latest_session(con)
        if sid and len(sid) < 36:
            row = con.execute("SELECT session_id FROM runs WHERE session_id LIKE ? "
                              "ORDER BY id DESC LIMIT 1", (sid + "%",)).fetchone()
            sid = row[0] if row else sid
        row = con.execute("SELECT engine FROM runs WHERE session_id = ? "
                          "ORDER BY id DESC LIMIT 1", (sid,)).fetchone() if sid else None
        print(sessioninfo.report(con, sid, engine=row[0] if row else None,
                                 cwd=config.ROOT))
    return 0


# --------------------------------------------------------------------------- notify

def cmd_notify(args) -> int:
    if args.file:
        # A file is a Telegram-only thing: the push channel carries text. The
        # title and body become the caption, so the file arrives labelled.
        path = pathlib.Path(args.file).expanduser()
        if not path.is_file():
            print(f"no such file: {path}", file=sys.stderr)
            return 1
        caption = args.title if not args.body else f"{args.title}\n{args.body}"
        ok = notify.telegram_document(path, caption=caption)
        if not ok:
            print("document send failed", file=sys.stderr)
        return 0 if ok else 1
    ok = notify.push(args.title, args.body, priority=args.priority, tags=args.tags,
                     click=args.click)
    if not ok:
        print("notification failed", file=sys.stderr)
    return 0 if ok else 1


# --------------------------------------------------------------------------- collect / cycle

def _child_env() -> dict:
    env = config.agent_env()
    google = pathlib.Path(
        str(config.get("google.credentials_dir", "~/.config/google-agent"))).expanduser()
    env["PYTHONPATH"] = os.pathsep.join(
        [str(config.ROOT / "lib"), str(google), *extensions.lib_paths(),
         env.get("PYTHONPATH", "")]).rstrip(os.pathsep)
    env["HERALD_HOME"] = str(config.HOME)
    # Extensions live outside the program and need to find it. Passing the
    # path beats every alternative: an extension that hardcodes ~/herald
    # breaks the moment someone clones it somewhere else.
    env["HERALD_ROOT"] = str(config.ROOT)
    return env


def _discover(kind: str) -> dict[str, pathlib.Path]:
    """Built-in modules of this kind, plus every enabled extension's.

    An extension's collector is a collector: same contract, same timer, same
    rules, discovered the same way. The only difference is that it lives in
    the user's private home rather than in the program.
    """
    d = config.ROOT / kind
    found = {p.stem: p for p in sorted(d.glob("*.py")) if not p.stem.startswith("_")}
    extra = extensions.collectors() if kind == "collectors" else extensions.cycles()
    for name, (path, _ext) in extra.items():
        found.setdefault(name, path)
    return found


def _cadence(path: pathlib.Path) -> int:
    """Minutes between runs, as the collector itself declares.

    Read out of the source rather than imported, because importing a collector
    to ask how often it should run would connect to its source to find out.
    """
    m = re.search(r"^CADENCE_MINUTES\s*=\s*(\d+)", path.read_text(), re.M)
    return int(m.group(1)) if m else 30


def _requires(path: pathlib.Path) -> tuple[str, ...]:
    """The capabilities a collector declares. Read, not imported, for the same
    reason as the cadence: asking a collector what it needs must not connect to
    the thing it needs."""
    m = re.search(r"^REQUIRES\s*=\s*\(([^)]*)\)", path.read_text(), re.M)
    if not m:
        return ()
    return tuple(part.strip().strip("\"'") for part in m.group(1).split(",") if part.strip())


def _due(name: str, minutes: int) -> tuple[bool, str]:
    """Whether this collector is due, and how long since it last succeeded."""
    row = db.query("SELECT last_ok FROM collector_state WHERE collector = ?", (name,))
    if not row or not row[0]["last_ok"]:
        return True, "never run"
    try:
        last = dt.datetime.fromisoformat(row[0]["last_ok"])
    except ValueError:
        return True, "unparseable timestamp"
    now = dt.datetime.now(last.tzinfo) if last.tzinfo else dt.datetime.now()
    age = (now - last).total_seconds() / 60
    return age >= minutes, f"{age:.0f}m ago"


def cmd_brain(args) -> int:
    return subprocess.run([str(config.ROOT / "bin" / "herald-brain"), args.action]).returncode


def cmd_attach(args) -> int:
    """Open the selected provider's terminal conversation."""
    from herald import think as think_mod  # noqa: PLC0415
    try:
        return think_mod.interactive(args.engine)
    except (ValueError, OSError) as exc:
        print(str(exc), file=sys.stderr)
        return 2


def cmd_collect(args) -> int:
    """Run the collectors that are due.

    Everything used to run on one 30-minute timer, which meant the address book
    was refetched 48 times a day and nine scraped event sites were read 48 times
    a day to learn nothing. Each collector now declares how often it is worth
    running, and naming one explicitly runs it regardless.
    """
    available = _discover("collectors")
    if not available:
        print(_c("no collectors installed yet", DIM))
        return 0

    explicit = bool(args.names)
    names = args.names or list(available)
    reconcile = getattr(args, 'reconcile', False)
    if reconcile and (not explicit or any(n not in ('gmail', 'gcal') for n in names)):
        print('--reconcile requires explicit gmail and/or gcal collectors', file=sys.stderr)
        return 2
    rc, skipped, off = 0, [], []

    for n in names:
        if n not in available:
            print(f"unknown collector: {n}", file=sys.stderr)
            rc = 2
            continue
        # A source the user never connected is off, not broken. Naming it
        # explicitly still refuses, because running it anyway would only
        # produce a traceback about a credential nobody was ever asked for.
        unmet = capabilities.unmet(_requires(available[n]))
        if unmet:
            why = "; ".join(f"{k}: {reason}" for k, reason in unmet)
            if explicit:
                print(f"{n}: off -- {why}", file=sys.stderr)
                rc = rc or 3
            else:
                off.append(f"{n} ({why})")
            continue
        if not explicit and not args.force:
            minutes = _cadence(available[n])
            due, age = _due(n, minutes)
            if not due:
                skipped.append(f"{n} ({age}, every {minutes}m)")
                continue
        print(_c(f"→ {n}", BOLD))
        r = subprocess.run([config.python(), str(available[n])]
                           + (["--reconcile"] if reconcile else []),
                           cwd=str(config.ROOT), env=_child_env())
        rc = rc or r.returncode

    if skipped:
        print(_c("not due: " + ", ".join(skipped), DIM))
    if off:
        print(_c("off: " + ", ".join(off), DIM))
    return rc


def cmd_mode(args) -> int:
    """Read or set this install's relationship to the program it runs."""
    if not args.mode:
        current = upstream.mode()
        print(f"  {_c(current, BOLD)}")
        print(_c({
            "tracking": "  follows upstream releases; the program is not this "
                        "install's to edit, and `herald update` fast-forwards",
            "fork": "  this install owns its program and will not receive "
                    "updates",
            "maintainer": "  this install IS upstream: it edits, commits and "
                          "pushes, and `herald release` is what reaches others",
        }[current], DIM))
        if current == "tracking":
            print(_c(f"  commit hook: "
                     f"{'installed' if upstream.hook_installed() else 'MISSING'}",
                     DIM))
        return 0
    was = upstream.mode()
    if args.mode == was:
        # Still sync the hook. A fresh install has no `mode` set at all, so it
        # is *already* tracking by default and would otherwise never get the
        # guard that makes tracking mean anything -- which is exactly how the
        # first test of it committed straight through.
        print(f"  already {was}  (commit hook {upstream.sync_hook()})")
        config.set_user("mode", was)
        return 0
    if args.mode == "tracking" and (local := upstream.local_changes())["commits"]:
        print(_c(f"  {len(local['commits'])} local commit(s) in the program repo. "
                 f"Tracking means fast-forwarding, which cannot happen over "
                 f"them.\n  Reset to upstream first, or stay a fork.", BAD),
              file=sys.stderr)
        return 1
    hook = upstream.set_mode(args.mode)
    print(f"  {was} → {_c(args.mode, BOLD)}  (commit hook {hook})")
    constitution_mod.write()
    print(_c("  CLAUDE.md regenerated: the rules a session reads changed with it",
             DIM))
    return 0


def cmd_update(args) -> int:
    """Fast-forward to the newest upstream release and reconcile."""
    current = upstream.mode()
    if current != "tracking" and not args.check:
        print(_c(f"  this install is a {current}, so it does not take updates.",
                 WARN))
        print(_c("  `herald update --check` still shows what upstream has done.",
                 DIM))
        return 1

    ok, err = upstream.fetch()
    if not ok:
        print(_c(f"  could not reach upstream: {err}", BAD), file=sys.stderr)
        return 1

    release = upstream.available()
    if not release:
        here = upstream.current_release() or upstream.current_commit()
        print(f"  up to date ({here})")
        return 0

    print(f"  {_c(release['tag'], BOLD)} is available "
          f"(you are on {release['from'] or 'an untagged commit'})")
    for line in release["commits"][:20]:
        print(f"    {line}")
    if len(release["commits"]) > 20:
        print(f"    …and {len(release['commits']) - 20} more")
    if release["notes"]:
        print()
        print(textwrap.indent(release["notes"][:1200], "  "))

    pending = migrations_mod.pending()
    if pending:
        print(f"\n  {len(pending)} migration(s) will run:")
        for name, path in pending:
            print(f"    {name}: {migrations_mod.describe(path)}")

    if args.check:
        print(_c("\n  `herald update` to apply it.", DIM))
        return 0

    print()
    result = upstream.apply(release["tag"], report=lambda m: print(f"  {m}"))
    if not result["ok"]:
        print(_c(f"  {result['error']}", BAD), file=sys.stderr)
        detail = result.get("detail") or {}
        for kind in ("modified", "commits"):
            for item in (detail.get(kind) or [])[:5]:
                print(f"    {kind}: {item}", file=sys.stderr)
        return 1
    if not result["checked"]:
        print(_c("\n  the invariant check does NOT pass after this update:", BAD))
        print(textwrap.indent(result["check_output"][-800:], "    "))
        print(_c("  services were not restarted. `herald check` for the detail.",
                 WARN))
        return 1
    print(_c(f"  {result['restart']}", DIM))
    notify.tell(f"Herald updated to {release['tag']}",
                (release["notes"] or "\n".join(release["commits"][:8]))[:1500],
                priority="low", tags="arrow_up")
    return 0


def cmd_release(args) -> int:
    """Cut a release: what other people's installs will move to."""
    if upstream.mode() != "maintainer":
        print(_c("  only a maintainer install cuts releases. This one is a "
                 f"{upstream.mode()}.", WARN), file=sys.stderr)
        return 1

    commits = upstream.unreleased()
    if not commits:
        print(f"  nothing since {upstream.current_release()}")
        return 0

    tag = upstream.next_version("major" if args.major else
                                "minor" if args.minor else "patch")
    print(f"  {_c(tag, BOLD)} would ship {len(commits)} commit(s) "
          f"since {upstream.current_release() or 'the beginning'}:")
    for line in commits:
        print(f"    {line}")

    if args.preview:
        print(_c("\n  `herald release` to cut it.", DIM))
        return 0

    # The one condition on publishing: nothing personal in the program.
    print()
    ok, output = upstream.check_invariants()
    if not ok:
        print(_c("  the invariant check fails, so this is not going out:", BAD))
        print(textwrap.indent(output[-900:], "    "))
        return 1
    print(_c("  invariants hold, including the personal-data scan", DIM))

    local = upstream.local_changes()
    if local["modified"]:
        print(_c(f"  {len(local['modified'])} uncommitted change(s); commit them "
                 f"first so the tag contains them.", BAD), file=sys.stderr)
        return 1

    upstream.set_version(tag)
    upstream.write_changelog(tag, commits)
    subprocess.run(["git", "add", "CHANGELOG.md", "lib/herald/__init__.py"],
                   cwd=str(config.ROOT), check=False)
    commit = subprocess.run(["git", "commit", "-q", "-m", f"Release {tag}"],
                            cwd=str(config.ROOT), capture_output=True, text=True)
    if commit.returncode != 0:
        # Tagging anyway would publish a release whose tag misses its own
        # version bump, which v0.4.0 did once and needed a forced tag to fix.
        print(_c(f"  the release commit failed, so nothing was tagged: "
                 f"{(commit.stderr or commit.stdout).strip()[:300]}", BAD), file=sys.stderr)
        print(_c("  CHANGELOG.md and lib/herald/__init__.py are staged; fix the "
                 "cause and run `herald release` again", DIM), file=sys.stderr)
        return 1
    subprocess.run(["git", "tag", "-a", tag, "-m", f"Herald {tag}"],
                   cwd=str(config.ROOT), check=False)
    push = subprocess.run(["git", "push", "-q", "origin", "main", tag],
                          cwd=str(config.ROOT), capture_output=True, text=True)
    if push.returncode != 0:
        print(_c(f"  tagged locally, but the push failed: "
                 f"{(push.stderr or '').strip()[:300]}", BAD), file=sys.stderr)
        return 1
    print(f"  released {_c(tag, OK)}. Installs that receive updates will offer it within a day")
    return 0


def cmd_services(args) -> int:
    """Install, enable or inspect the background jobs on this platform."""
    sys.path.insert(0, str(config.ROOT))
    from setup import services  # noqa: PLC0415
    if args.action == "status":
        rows = services.status()
        if not rows:
            print(_c("  " + (services.unavailable_reason() or
                             "nothing is switched on yet: `herald services enable`"),
                     DIM))
            return 0
        for unit, state in rows:
            colour = OK if state in ("active", "loaded") else DIM
            print(f"  {_c(f'{state:<12}', colour)} {unit}")
        return 0
    try:
        result = services.install(force=getattr(args, "force", False))
    except services.ForeignInstall as exc:
        print(_c("  " + str(exc), BAD), file=sys.stderr)
        return 1
    if result["platform"] == "none":
        print(_c("  " + result.get("note", "nothing to install"), WARN))
        return 0
    for name in result["written"]:
        print(f"  installed {name}")
    if not result["written"]:
        print(_c("  already current", DIM))
    if args.action == "enable":
        telegram = bool(config.secret("telegram.bot_token"))
        units = services.wanted_units(telegram)
        if result["platform"] == "systemd":
            for unit, ok, err in services.enable_systemd(units):
                print(f"  {'enabled' if ok else 'FAILED '} {unit}"
                      + (f"  {err}" if err else ""))
            linger_ok, how = services.enable_linger()
            if not linger_ok:
                print(_c(f"  run `{how}` so they survive logging out", WARN))
        else:
            print(_c(f"  {len(units)} agent(s) loaded", DIM))
    else:
        print(_c("  `herald services enable` to start them", DIM))
    return 0


def cmd_setup(args) -> int:
    """The wizard. One engine, two frontends -- see setup/engine.py."""
    sys.path.insert(0, str(config.ROOT))
    from setup import cli as setup_cli  # noqa: PLC0415
    argv = []
    if args.step:
        argv += ["--step", args.step]
    if args.list:
        argv += ["--list"]
    if args.web:
        argv += ["--web", "--port", str(args.port)]
    return setup_cli.main(argv)


def cmd_constitution(args) -> int:
    """Rebuild CLAUDE.md from the shared rules plus this person's own.

    Generated rather than imported: Claude Code will not follow the `ledger`
    symlink out of the project to resolve an @import, and a silently dropped
    import here drops medical facts and academic-integrity rules. See
    lib/herald/constitution.py.
    """
    if args.check:
        if constitution_mod.current():
            print(_c("  CLAUDE.md is current", OK))
            return 0
        print(_c("  CLAUDE.md has drifted from its sources", BAD), file=sys.stderr)
        return 1
    changed = constitution_mod.write()
    print(f"  {'rewrote' if changed else 'already current:'} {constitution_mod.OUTPUT}")
    if not constitution_mod.PERSONAL.exists():
        print(_c(f"  no personal constitution yet at "
                 f"{constitution_mod.PERSONAL}. Run `herald setup`", WARN))
    return 0


def cmd_config(args) -> int:
    """Read or write one setting.

    Writes only ever touch $HERALD_HOME/config.json: config/defaults.json
    belongs to whoever packaged Herald. So anything set here survives an
    update, and anything never set here follows one.
    """
    if args.action == "get":
        value = config.get(args.path) if args.path else config.load()
        print(json.dumps(value, indent=2, default=str))
        return 0
    if args.action == "path":
        print(config.CONFIG_PATH)
        return 0
    raw = args.value
    if raw is None:
        print("nothing to set", file=sys.stderr)
        return 2
    try:
        value = json.loads(raw)          # numbers, true/false, lists, objects
    except json.JSONDecodeError:
        value = raw                      # a bare string is a string
    config.set_user(args.path, value)
    print(f"  {args.path} = {json.dumps(value)}")
    return 0


def cmd_test(args) -> int:
    """The offline suite: the program's, plus every enabled extension's.

    Extensions ship tests for the same reason Herald does -- the parsing in
    one is exactly the kind of thing that breaks quietly -- and a suite that
    only covers the program would stop covering most of the code the moment
    someone's life moved into an extension.
    """
    rc = subprocess.run([config.python(), "-m", "unittest", "discover",
                         "-s", "tests", *args.extra],
                        cwd=str(config.ROOT), env=_child_env()).returncode
    for path in extensions.test_paths():
        print(_c(f"\n{path.parent.name} extension", BOLD))
        r = subprocess.run([config.python(), "-m", "unittest", "discover",
                            "-s", str(path), *args.extra],
                           cwd=str(path.parent), env=_child_env()).returncode
        rc = rc or r
    return rc


def cmd_ext(args) -> int:
    """Extensions: the code that is about this person's life, not about Herald."""
    if args.action in ("list", None):
        found = extensions.all_extensions()
        if not found:
            print(_c(f"no extensions in {config.EXTENSIONS}", DIM))
            print(_c("  herald ext new <name>   to start one", DIM))
            return 0
        for ext in found:
            state = _c("on ", OK) if ext.enabled else _c("off", DIM)
            parts = []
            if ext.collectors():
                parts.append(f"{len(ext.collectors())} collector(s)")
            if ext.cycles():
                parts.append(f"{len(ext.cycles())} cycle(s)")
            if ext.units():
                parts.append(f"{len(ext.units())} unit(s)")
            if ext.skills():
                parts.append(f"{len(ext.skills())} skill(s)")
            if ext.hooks():
                parts.append("hooks")
            print(f"  {state} {ext.name:14} {ext.description[:70]}")
            if ext.source():
                parts.append(f"from {ext.source()}")
            if parts:
                print(f"      {_c(', '.join(parts), DIM)}")
        return 0

    if args.action == "install":
        if not args.name:
            print("usage: herald ext install <git-url> [--enable]", file=sys.stderr)
            return 2
        try:
            ext = extensions.install(args.name, enable=args.enable)
        except (RuntimeError, FileExistsError) as exc:
            print(f"  {exc}", file=sys.stderr)
            return 1
        print(f"  installed {ext.name} at {ext.path}")
        print(f"  {ext.description}")
        _print_provides(ext)
        _print_needed(ext)
        if ext.settings_needed():
            print(_c(f"  answer them with: herald ext setup {ext.name}", DIM))
        if (ext.path / "README.md").exists():
            print(_c(f"  read first: {ext.path / 'README.md'}", DIM))
        if ext.enabled:
            _print_sync(extensions.sync())
        else:
            print(_c(f"  off until you run: herald ext enable {ext.name}", DIM))
        if ext.units():
            print(_c("  it ships systemd units: run tools/install-units.sh after "
                     "enabling", DIM))
        return 0

    if args.action == "update":
        names = [args.name] if args.name else [
            e.name for e in extensions.all_extensions() if e.own_repo()]
        if not names:
            print(_c("  no installed extension has a repository to update from", DIM))
            return 0
        rc = 0
        for name in names:
            try:
                r = extensions.update(name)
            except LookupError as exc:
                print(f"  {exc}", file=sys.stderr)
                return 2
            colour = {"updated": OK, "current": DIM}.get(r["status"], WARN)
            print(f"  {r['name']:14} {_c(r['status'], colour)}  {r['detail']}")
            for line in r.get("log", []):
                print(_c(f"      {line}", DIM))
            if r["status"] in ("changed", "failed"):
                rc = 1
            elif r["status"] == "updated":
                ext = extensions.find(name)
                _print_needed(ext)
        return rc

    if args.action == "setup":
        ext = extensions.find(args.name or "")
        if not ext:
            print("usage: herald ext setup <name> [--json]", file=sys.stderr)
            return 2
        todo = [i for i in ext.setup_items() if not i["set"]]
        steps = [str(s) for s in ext.manifest.get("steps", []) or []]
        if args.json or not sys.stdin.isatty():
            # For a session: it asks the user each question in chat, answers
            # with `herald config set` or `herald secret request`, and walks
            # them through the steps (a package to install, an account to
            # create, a first login) in order.
            print(json.dumps({"extension": ext.name, "questions": todo,
                              "steps": steps,
                              "readme": str(ext.path / "README.md")
                              if (ext.path / "README.md").exists() else None},
                             indent=2))
            return 0
        for n, step in enumerate(steps, 1):
            print(f"  step {n}: {step}")
        if not todo:
            print(f"  {ext.name} has every setting it asks for")
            return 0
        for item in todo:
            if item.get("secret"):
                print(f"  {item['prompt']}: a secret. Run "
                      + _c(f"herald secret request {item['key']} --why '{ext.name}'", DIM))
                continue
            hint = item.get("default") or item.get("example") or ""
            raw = input(f"  {item['prompt']}{f' [{hint}]' if hint else ''}: ").strip()
            if not raw and "default" in item:
                value = extensions._expand(item["default"])
            elif not raw:
                print(_c("    skipped", DIM))
                continue
            elif item.get("type") in ("list", "object", "number", "boolean"):
                try:
                    value = json.loads(raw)
                except json.JSONDecodeError:
                    value = [v.strip() for v in raw.split(",")] if item["type"] == "list" else raw
            else:
                value = raw
            config.set_user(item["key"], value)
            print(_c(f"    {item['key']} = {json.dumps(value)}", DIM))
        return 0

    if args.action == "check":
        if not args.name:
            print("usage: herald ext check <name>", file=sys.stderr)
            return 2
        try:
            problems, notes = extensions.publish_problems(args.name)
        except LookupError as exc:
            print(f"  {exc}", file=sys.stderr)
            return 2
        for note in notes:
            print(_c(f"  {note}", DIM))
        for problem in problems:
            print(f"  {_c('FAIL', BAD)}  {problem}")
        if problems:
            print(f"  {len(problems)} problem(s): fix these before publishing {args.name}")
            return 1
        print(f"  {_c('ready to publish', OK)}: nothing personal found")
        return 0

    if args.action == "new":
        path = extensions.scaffold(args.name)
        print(f"  {path}")
        print(_c("  drop a collector in collectors/ and it runs on the next timer",
                 DIM))
        return 0

    if args.action in ("enable", "disable"):
        ext = extensions.set_enabled(args.name, args.action == "enable")
        print(f"  {ext.name} {'enabled' if ext.enabled else 'disabled'}")
        report = extensions.sync()
        _print_sync(report)
        if ext.units():
            print(_c("  it ships systemd units: run tools/install-units.sh", DIM))
        return 0

    if args.action == "sync":
        _print_sync(extensions.sync())
        return 0
    return 2


def _print_provides(ext) -> None:
    """What turning it on would run, read from its directory and manifest."""
    for label, items in (("collectors", list(ext.collectors())),
                         ("cycles", list(ext.cycles())),
                         ("skills", [p.name for p in ext.skills()]),
                         ("units", [p.name for p in ext.units()])):
        if items:
            print(f"    {label}: {', '.join(items)}")
    if ext.hooks():
        print(f"    hooks: {', '.join(sorted((ext.hooks().get('hooks') or {})))} "
              f"(these run in every session)")
    if (ext.path / "red.py").exists():
        print("    red actions of its own, behind the usual tap")


def _print_needed(ext) -> None:
    for item in ext.setup_items():
        if item["set"] or not item["required"]:
            continue
        kind = "secret" if item.get("secret") else "setting"
        ask = item["prompt"] if item["prompt"] != item["key"] else ""
        print(f"  needs {kind} {item['key']}{': ' + ask if ask else ''}")


def _print_sync(report: dict) -> None:
    for name in report.get("skills_linked", []):
        print(f"  linked skill {name}")
    for name in report.get("skills_removed", []):
        print(f"  unlinked skill {name}")
    for name in report.get("commands_linked", []):
        print(f"  command {name} now runs from any shell")
    for name in report.get("commands_removed", []):
        print(f"  removed command {name}")
    events = report.get("hook_events") or []
    print(_c(f"  .claude/settings.json written"
             f"{' (hooks: ' + ', '.join(events) + ')' if events else ' (no hooks)'}",
             DIM))


def cmd_cycle(args) -> int:
    available = _discover("cycles")
    if args.name not in available:
        print(f"unknown cycle: {args.name}. have: {', '.join(available) or '(none yet)'}",
              file=sys.stderr)
        return 2
    env = _child_env()
    # Nobody is at a keyboard. Tools that may only act on a request made in a
    # conversation read this and refuse; the session itself is told the same
    # thing in the prompt, and this is the half that does not depend on the
    # session believing it.
    env["HERALD_UNATTENDED"] = "1"
    rc = subprocess.run([config.python(), str(available[args.name])],
                        cwd=str(config.ROOT), env=env).returncode
    # A cycle rewrites state/ and appends to journal/. Committed here, in the
    # one place every cycle passes through, rather than trusting each cycle's
    # session to remember -- the ledger's history is only as real as this.
    try:
        from herald import ledger  # noqa: PLC0415
        if (short := ledger.commit(f"cycle: {args.name}")):
            print(f"  ledger committed ({short})")
    except Exception as exc:                                        # noqa: BLE001
        print(f"  ledger not committed: {exc}", file=sys.stderr)
    return rc


# --------------------------------------------------------------------------- main

def cmd_latency(args) -> int:
    """Where does a turn's wall clock go?

    Written because "it takes 90 seconds to answer" had no answer in the ledger.
    Measured across 108 transcripts on 12 Sep 2026: model time was 68% of all
    elapsed time, tool time 32%, and an average turn made 21 model round trips
    at a median of 2.9s each. Latency is therefore round trips multiplied by
    per-round-trip model time, and the fix for a slow turn is almost always
    fewer round trips rather than faster tools.

    `runs` and `run_phases` carry this from 12 Sep 2026 onward. `--transcripts`
    reads Claude Code's own session files instead, which is the only way to see
    anything older; it is slower and it will matter less every week.
    """
    if args.transcripts:
        return _latency_from_transcripts(args)
    if args.run:
        rows = db.query(
            "SELECT seq, kind, name, ms, detail FROM run_phases "
            "WHERE run_id = ? ORDER BY seq", (args.run,))
        if not rows:
            print(f"no phases recorded for run {args.run}")
            return 1
        head = db.query("SELECT label, model, duration_ms, round_trips "
                        "FROM runs WHERE id = ?", (args.run,))
        if head:
            h = head[0]
            print(f"{_c('run ' + str(args.run), BOLD)}  {h['label']}  "
                  f"{h['model'] or '?'}  {(h['duration_ms'] or 0)/1000:.1f}s  "
                  f"{h['round_trips'] or 0} round trips")
        _hdr("timeline")
        for r in rows:
            label = r["name"] or r["kind"]
            bar = "#" * min(40, int((r["ms"] or 0) / 250))
            print(f"  {r['ms']:7d}ms {r['kind']:<8} {label:<16} {bar}")
            if r["detail"]:
                print(f"  {_c('          ' + r['detail'][:70], DIM)}")
        return 0

    since = f"-{args.days} days"
    _hdr(f"where the time goes  (last {args.days} days)")
    rows = db.query("""
        SELECT label,
               COUNT(*)                                   AS runs,
               ROUND(AVG(COALESCE(duration_ms,0))/1000,1)  AS avg_s,
               ROUND(AVG(COALESCE(startup_ms,0))/1000,2)   AS startup_s,
               ROUND(AVG(COALESCE(model_ms,0))/1000,1)     AS model_s,
               ROUND(AVG(COALESCE(tool_ms,0))/1000,1)      AS tool_s,
               ROUND(AVG(COALESCE(round_trips,0)),1)       AS trips
        FROM runs
        WHERE ts >= datetime('now', ?) AND round_trips IS NOT NULL
        GROUP BY label ORDER BY runs DESC LIMIT 15
    """, (since,))
    if not rows:
        print(f"  {_c('nothing instrumented yet in that window.', DIM)}")
        print(f"  {_c('Phase timing starts at the first run after 12 Sep 2026;', DIM)}")
        print(f"  {_c('use --transcripts for anything older.', DIM)}")
        return 0
    print(f"  {'label':<24}{'runs':>5}{'turn':>8}{'startup':>9}"
          f"{'model':>8}{'tools':>8}{'trips':>7}")
    for r in rows:
        print(f"  {r['label']:<24}{r['runs']:>5}{r['avg_s']:>7.1f}s"
              f"{r['startup_s']:>8.2f}s{r['model_s']:>7.1f}s"
              f"{r['tool_s']:>7.1f}s{r['trips']:>7.1f}")
    print(f"  {_c('trips = model round trips. A turn cannot be faster than', DIM)}")
    print(f"  {_c('trips x per-trip model time, whatever the tools do.', DIM)}")

    _hdr("slowest tools")
    rows = db.query("""
        SELECT name,
               COUNT(*)                       AS calls,
               ROUND(SUM(ms)/1000.0,1)        AS total_s,
               ROUND(AVG(ms)/1000.0,2)        AS mean_s,
               ROUND(MAX(ms)/1000.0,1)        AS max_s
        FROM run_phases
        WHERE kind = 'tool' AND run_id IN (
            SELECT id FROM runs WHERE ts >= datetime('now', ?))
        GROUP BY name ORDER BY total_s DESC LIMIT 12
    """, (since,))
    if not rows:
        print(f"  {_c('no tool phases in that window', DIM)}")
    else:
        print(f"  {'tool':<28}{'calls':>7}{'total':>9}{'mean':>8}{'max':>8}")
        for r in rows:
            print(f"  {r['name'] or '?':<28}{r['calls']:>7}"
                  f"{r['total_s']:>8.1f}s{r['mean_s']:>7.2f}s{r['max_s']:>7.1f}s")

    _hdr("slowest individual runs")
    rows = db.query("""
        SELECT id, label, ROUND(duration_ms/1000.0,1) s, round_trips
        FROM runs
        WHERE ts >= datetime('now', ?) AND round_trips IS NOT NULL
        ORDER BY duration_ms DESC LIMIT 8
    """, (since,))
    for r in rows:
        print(f"  run {r['id']:<7}{r['label']:<24}{r['s']:>7.1f}s"
              f"{r['round_trips'] or 0:>5} trips   "
              f"{_c('herald latency --run ' + str(r['id']), DIM)}")
    return 0


def _latency_from_transcripts(args) -> int:
    """The same breakdown, recovered from Claude Code's session files.

    Only way to see turns from before `run_phases` existed. Reads
    ~/.claude/projects/<slug>/*.jsonl, where the slug is the cwd with
    separators replaced by dashes, and reconstructs the timeline from event
    timestamps: a tool span is a `tool_use` block to its matching
    `tool_result`, and everything else is the model.
    """
    import json
    import statistics
    from datetime import datetime

    slug = str(config.ROOT).replace("/", "-")
    root = pathlib.Path.home() / ".claude" / "projects" / slug
    if not root.is_dir():
        print(f"no transcripts at {root}")
        return 1

    def when(raw):
        return datetime.fromisoformat(raw.replace("Z", "+00:00")).timestamp()

    tool_total: dict[str, float] = {}
    tool_calls: dict[str, int] = {}
    model_gaps: list[float] = []
    turns: list[float] = []
    trips: list[int] = []
    files = 0

    for path in sorted(root.glob("*.jsonl")):
        files += 1
        pending: dict = {}
        last = start = None
        n_trips = 0
        for line in path.open(errors="replace"):
            try:
                d = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not d.get("timestamp"):
                continue
            t, kind = when(d["timestamp"]), d.get("type")
            content = (d.get("message") or {}).get("content")
            blocks = content if isinstance(content, list) else []
            if kind == "assistant":
                n_trips += 1
                if last is not None and t > last:
                    model_gaps.append(t - last)
                for b in blocks:
                    if isinstance(b, dict) and b.get("type") == "tool_use":
                        pending[b.get("id")] = (b.get("name") or "?", t)
                last = t
            elif kind == "user":
                results = [b for b in blocks if isinstance(b, dict)
                           and b.get("type") == "tool_result"]
                if results:
                    for b in results:
                        got = pending.pop(b.get("tool_use_id"), None)
                        if got:
                            tool_total[got[0]] = tool_total.get(got[0], 0) + t - got[1]
                            tool_calls[got[0]] = tool_calls.get(got[0], 0) + 1
                    last = t
                else:
                    if start is not None and last is not None:
                        turns.append(last - start)
                        trips.append(n_trips)
                    start = last = t
                    n_trips = 0
        if start is not None and last is not None:
            turns.append(last - start)
            trips.append(n_trips)

    if not model_gaps:
        print(f"read {files} transcripts, found no timed turns")
        return 1

    mg, mt = sum(model_gaps), sum(tool_total.values())
    _hdr(f"reconstructed from {files} transcripts")
    print(f"  model time  {mg/3600:8.1f}h   {mg/(mg+mt)*100:.0f}% of measured")
    print(f"  tool time   {mt/3600:8.1f}h   {mt/(mg+mt)*100:.0f}%")
    print(f"  round trips per turn: median "
          f"{statistics.median(trips):.0f}, mean {sum(trips)/len(trips):.1f}")
    print(f"  model gap:  median {statistics.median(model_gaps):.1f}s, "
          f"mean {mg/len(model_gaps):.1f}s")
    print(f"  whole turn: median {statistics.median(turns):.0f}s, "
          f"mean {sum(turns)/len(turns):.0f}s")

    _hdr("tool time by tool")
    print(f"  {'tool':<28}{'calls':>7}{'total':>9}{'mean':>8}{'share':>7}")
    for name, secs in sorted(tool_total.items(), key=lambda kv: -kv[1])[:12]:
        n = tool_calls[name]
        print(f"  {name:<28}{n:>7}{secs:>8.0f}s{secs/n:>7.2f}s"
              f"{secs/mt*100:>6.1f}%")
    return 0


def cmd_orient(args) -> int:
    """Write `state/orientation.md`.

    The Telegram bridge refreshes this whenever it starts a session, so it is
    usually current without anyone asking. This exists for the surfaces that
    are spawned by Claude Code itself -- claude.ai/code, a terminal -- where
    there is no flag to inject anything and the file is the only way in.
    """
    sys.path.insert(0, str(config.ROOT))
    from cycles import _snapshot
    with db.session() as con:
        text = _snapshot.orientation(con)
    dest = config.LEDGER / "state" / "orientation.md"
    dest.write_text(text)
    if args.show:
        print(text)
    else:
        print(f"wrote {dest}  ({len(text)} bytes, ~{len(text)//4} tokens)")
    return 0



def cmd_ask(args) -> int:
    """Ask in the current topic; return a durable answer or consent receipt."""
    from herald import questions  # noqa: PLC0415
    try:
        if args.question_id is not None:
            row = questions.result(args.question_id)
        else:
            text = (pathlib.Path(args.file).expanduser().read_text()
                    if args.file else args.question)
            row = questions.request(text, options=args.option, approval=args.approval,
                                    actor=args.actor, timeout=args.timeout,
                                    wake=not args.wait, thread_id=args.telegram_thread)
        if args.wait:
            row = questions.wait(row["id"])
    except (OSError, ValueError, RuntimeError, PermissionError) as exc:
        print(f"cannot ask: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(row, ensure_ascii=False))
    if row["state"] == "expired":
        return 3
    if row["approval_id"] and row["state"] == "answered" and not row.get("approved"):
        return 3
    return 0


def cmd_act(args) -> int:
    """Carry out an outward action through the right door.

    The guard hook blocks a session's own script from writing to Google
    directly, because such a write never reaches the actions table. This is
    where the blocked session is pointed instead, for the two cases that are
    awkward to do from a script: red actions, which have to wait on a tap, and
    the everyday "put this file in my Drive".

    Red kinds block until the user answers on their phone or the request
    expires. That is intended: the answer to "did it send" should be the real
    answer, not "I asked".
    """
    from herald import gwrite, red  # noqa: PLC0415

    if args.kind == "drive-upload":
        import mimetypes  # noqa: PLC0415
        path = pathlib.Path(args.path).expanduser()
        if not path.is_file():
            print(f"no such file: {path}", file=sys.stderr)
            return 1
        with db.session() as con:
            f = gwrite.drive_create(
                con, actor=args.actor, name=args.name or path.name, path=str(path),
                mime_type=mimetypes.guess_type(path.name)[0], folder=args.folder)
        print(json.dumps({"name": f.get("name"), "id": f.get("id"),
                          "link": f.get("webViewLink")}))
        return 0

    if args.kind == "mail-send":
        body = (pathlib.Path(args.body_file).expanduser().read_text()
                if args.body_file else args.body)
        if not body:
            print("mail-send needs --body or --body-file", file=sys.stderr)
            return 1
        payload = {"to": args.to, "subject": args.subject, "body": body}
        for key in ("cc", "thread_id", "in_reply_to"):
            if getattr(args, key):
                payload[key] = getattr(args, key)
        result = red.run("mail.send", payload, actor=args.actor,
                         timeout=args.timeout, thread_id=args.telegram_thread)
    elif args.kind == "issue-open":
        try:
            body = pathlib.Path(args.body_file).expanduser().read_text()
            payload = {"repo": args.repo, "title": args.title, "body": body}
            rendered = red.render("github.issue", payload)
        except (OSError, ValueError) as exc:
            print(f"cannot prepare the issue: {exc}", file=sys.stderr)
            return 1
        if args.show:
            print(rendered)
            return 0
        result = red.run("github.issue", payload, actor=args.actor,
                         timeout=args.timeout, thread_id=args.telegram_thread)
    elif args.kind == "pr-open":
        # The payload is read from the checkout itself, so the tap shows the
        # branch as it is, with its commit hash, and the performer refuses to
        # push if the branch has moved since.
        from herald import ghpr  # noqa: PLC0415
        body = (pathlib.Path(args.body_file).expanduser().read_text()
                if args.body_file else (args.body or ""))
        try:
            payload = ghpr.describe(cwd=args.dir, host=args.host, repo=args.repo,
                                    base=args.base, title=args.title, body=body,
                                    branch=args.branch, remote=args.remote)
        except ghpr.PullRequestError as exc:
            print(f"cannot prepare the pull request: {exc}", file=sys.stderr)
            return 1
        if args.show:
            print(red.render("github.pr", payload))
            return 0
        result = red.run("github.pr", payload, actor=args.actor,
                         timeout=args.timeout, thread_id=args.telegram_thread)
    elif args.kind == "drill":
        result = red.run("drill", {}, actor=args.actor, timeout=args.timeout,
                         thread_id=args.telegram_thread)
    elif args.kind == "run":
        # A kind an extension ships. The payload comes from a file because it
        # is the exact thing the user is shown and the exact thing done.
        extension_kinds = sorted(set(red.kinds()) - set(red.KINDS))
        if args.red_kind not in extension_kinds:
            print(f"{args.red_kind!r} is not an extension's red kind; "
                  f"known: {extension_kinds}", file=sys.stderr)
            return 1
        try:
            payload = json.loads(pathlib.Path(args.payload_file).expanduser().read_text())
        except (OSError, json.JSONDecodeError) as exc:
            print(f"cannot read payload: {exc}", file=sys.stderr)
            return 1
        if args.show:
            print(red.render(args.red_kind, payload))
            return 0
        result = red.run(args.red_kind, payload, actor=args.actor,
                         timeout=args.timeout, thread_id=args.telegram_thread)
    else:
        print(f"unknown kind {args.kind}", file=sys.stderr)
        return 1
    print(json.dumps(result))
    return 0 if result.get("state") == "done" else 3


def cmd_safety(args) -> int:
    """Herald's own safety rules: see them, test a command, lift one on a tap.

    The rules live in lib/herald/safety.py and run in tools/guard.py before
    every hooked tool call, on Claude and Codex alike. `allow` is the only way
    a session gets past one: it puts the rule and the blocked command on the
    user's phone, and only their tap writes the short-lived allowance the
    guard reads.
    """
    from herald import red, safety  # noqa: PLC0415

    root, home = str(config.ROOT), str(config.HOME)
    if args.op == "status":
        s = safety.load(root, home)
        print(f"engine mode: {safety.engine_mode('telegram', root, home)} on telegram, "
              f"{safety.engine_mode('cycle', root, home)} for cycles")
        for rule in safety.RULES:
            lifted = "  (lifted by a tap, for now)" if rule in s.allowed else ""
            print(f"  {rule:16} {s.rules.get(rule, 'block')}{lifted}")
        print(f"  protected paths: {', '.join(s.protected_paths) or '(none)'}")
        return 0

    if args.op == "test":
        command = " ".join(args.command)
        s = safety.load(root, home)
        findings = safety.check_bash(command, os.getcwd(), s)
        if not findings:
            print("allowed: no rule matches")
            return 0
        block, warn = safety.verdict(findings, s)
        for f in findings:
            mode = "block" if f in block else ("warn" if f in warn else "off")
            print(f"  {mode:5} {f.rule:16} {f.what}")
        return 2 if block else 0

    # allow
    if args.rule not in safety.RULES:
        print(f"unknown rule {args.rule!r}; one of {', '.join(safety.RULES)}", file=sys.stderr)
        return 1
    payload = {"rule": args.rule, "minutes": args.minutes, "why": args.why or "",
               "command": args.command_text or ""}
    result = red.run("safety.allow", payload, actor=args.actor, timeout=args.timeout)
    print(json.dumps(result))
    return 0 if result.get("state") == "done" else 3


def cmd_root(args) -> int:
    """Run a command as root, only on the user's tap. See bin/herald-rootd.

    Sessions run under NoNewPrivileges and can never use sudo. `run` is how one
    asks instead: the exact command goes to the user's phone through a second
    Telegram bot that only a root process can read, and runs once if they tap.
    `setup`, `update` and `remove` re-run themselves under sudo, because they
    install a root-owned copy of the daemon; running it from this checkout would
    make anything that can edit the checkout root.
    """
    import getpass  # noqa: PLC0415
    from herald import rootcmd  # noqa: PLC0415

    if args.op == "status":
        st = rootcmd.status()
        if not st["supported"]:
            print("not available here: root approvals need Linux with systemd")
        elif not st["installed"]:
            print("not set up. `herald root setup` (needs sudo and a second Telegram bot)")
        else:
            stale = "" if st["current"] else \
                ", and the installed copy is older than this checkout: `herald root update`"
            print(f"herald-root: {'running' if st['active'] else 'NOT running'}{stale}")
        return 0 if st["active"] else 1

    if args.op in ("setup", "update", "remove"):
        if not rootcmd.supported():
            print("root approvals need Linux with systemd", file=sys.stderr)
            return 1
        if os.geteuid() != 0:
            argv = ["sudo", "env", f"HERALD_HOME={config.HOME}", sys.executable,
                    str(config.ROOT / "bin" / "herald"), "root", args.op,
                    "--for-user", getpass.getuser()]
            print("This installs or changes a root service, so it needs sudo:\n  "
                  + " ".join(argv) + "\n")
            os.execvp("sudo", argv)
        if args.op == "setup":
            if not args.for_user:
                print("run `herald root setup` as your own user, not under sudo",
                      file=sys.stderr)
                return 1
            return rootcmd.setup(args.for_user)
        return rootcmd.update() if args.op == "update" else rootcmd.remove()

    words = list(args.command)
    if words[:1] == ["--"]:
        words = words[1:]
    command = " ".join(words).strip()
    if not command:
        print("usage: herald root run --why '<reason>' -- <command>", file=sys.stderr)
        return 1
    try:
        result = rootcmd.run(command, why=args.why or "", cwd=args.cwd or os.getcwd(),
                             timeout=args.timeout, actor=args.actor)
    except rootcmd.Unavailable as exc:
        print(str(exc), file=sys.stderr)
        return 4
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    out = result.get("output") or ""
    if out:
        sys.stdout.write(out if out.endswith("\n") else out + "\n")
    state = result.get("state")
    tail = f", exit {result['exit_code']}" if "exit_code" in result else ""
    note = f" ({result['note']})" if result.get("note") else ""
    print(f"[herald root: {state}{tail}{note}]", file=sys.stderr)
    if state == "done":
        return 0
    if state in ("failed", "timeout"):
        return int(result.get("exit_code") or 1) or 1
    return 3


def cmd_secret(args) -> int:
    """Take a secret from the user's phone without it passing through a model.

    `request` sends them a one-time link to a page served by bin/herald-secrets;
    what they paste goes straight into secrets.json. See lib/herald/secretintake.py.
    """
    from herald import notify, secretintake  # noqa: PLC0415

    if args.op == "has":
        ok = secretintake.has(args.path)
        print("set" if ok else "not set")
        return 0 if ok else 1
    if args.op == "status":
        rows = secretintake.all_requests()[:args.limit]
        if not rows:
            print(_c("  no requests", DIM))
        for r in rows:
            when = dt.datetime.fromtimestamp(r["created"]).strftime("%a %d %b %H:%M")
            print(f"  {r['id']}  {r['state']:<8} {when}  {r['path']}")
        if not secretintake.enabled():
            print(_c("  no intake URL set: surfaces.secret_intake.url", WARN))
        return 0
    if args.op == "wait":
        state = secretintake.wait(args.id)
        print(state)
        return 0 if state == "stored" else 1

    try:
        req, url = secretintake.request(
            args.path, why=args.why or "", as_json=args.json, minutes=args.minutes,
            actor=args.actor, thread_id=notify._live_topic_thread())
    except (ValueError, LookupError) as exc:
        print(str(exc), file=sys.stderr)
        return 1
    replaces = " It replaces the value already there." if req["replaces"] else ""
    sent = notify.telegram(
        f"Paste `{req['path']}` here (works once, for {args.minutes} minutes):\n"
        f"{url}\n\nWhy: {req['why']}{replaces}", thread_id=req["thread_id"])
    if sent:
        print(f"request {req['id']}: a link for {req['path']} is on the user's phone")
    else:
        # Nowhere to push, so this is someone at a terminal: the link is theirs.
        print(f"request {req['id']}: Telegram did not take it. Open:\n  {url}")
    if args.wait:
        state = secretintake.wait(req["id"])
        print(state)
        return 0 if state == "stored" else 1
    return 0


def cmd_obligation(args) -> int:
    """Open loops: add, close, list. See lib/herald/obligations.py.

    The only way a session or cycle should add one, because adding through
    here is what shows it to the user with Keep / Done / Drop."""
    from herald import obligations  # noqa: PLC0415

    with db.session() as con:
        if args.op == "list":
            print(obligations.render(con))
        elif args.op == "add":
            oid = obligations.add(con, text=args.text, kind=args.kind, due=args.due,
                                  notes=args.notes, source_fact=args.fact,
                                  tell=not args.quiet)
            print(f"#{oid}")
        elif args.op in ("done", "drop"):
            row = obligations.close(con, args.id, "done" if args.op == "done" else "dropped",
                                    args.why, tell=not args.quiet)
            print("closed" if row else f"#{args.id} is not open")
            return 0 if row else 1
    return 0


def cmd_deadline(args) -> int:
    """Quizzes, tests and due dates, kept on the calendar. See lib/herald/deadlines.py."""
    from herald import deadlines  # noqa: PLC0415

    with db.session() as con:
        if args.op == "list":
            for d in deadlines.upcoming(con, args.days):
                print(f"#{d['id']:<4} {d['due'][:16]:16} {d['kind']:5} {d['title']}"
                      f"  [{d['source']}]")
        elif args.op == "add":
            did = deadlines.add(con, source="manual", ref=None, course=args.course,
                                kind=args.kind, title=args.title, due=args.due,
                                end_at=args.end, notes=args.notes)
            print(f"#{did}  (on the calendar at the next sync, or run `herald deadline sync`)")
        elif args.op == "cancel":
            n = con.execute("UPDATE deadlines SET status='cancelled', updated_at=?,"
                            " notes=coalesce(notes,'') || ? WHERE id=?",
                            (db.now(), f"\ncancelled: {args.why}", args.id)).rowcount
            print("cancelled" if n else f"no deadline #{args.id}")
            return 0 if n else 1
        elif args.op == "sync":
            print(json.dumps(deadlines.sync(con, dry_run=args.dry_run)))
    return 0


def cmd_browse(args) -> int:
    """Browse the web in a real browser on this machine. See lib/herald/browse.py."""
    from herald import browse  # noqa: PLC0415

    op = args.op
    if op == 'login':
        from herald import browser_workspaces as bw, notify
        workspace=bw.name(args.workspace)
        w=bw.get(workspace)
        if w and w['state']=='human':
            # An expired login link must be replaceable without taking a
            # Playwright lease away from the human review controller.
            records=[]
            for path in browse.spool().glob('*.json'):
                try:rec=json.loads(path.read_text())
                except (OSError,ValueError):continue
                if rec.get('workspace')==workspace and rec.get('tab')==args.tab:records.append(rec)
            if not records:raise SystemExit('Use the exact tab id from the previous sign-in handoff.')
            token=browse.new_view(args.tab,args.why,args.minutes,workspace=workspace)
            sent=notify.telegram(f"Your browser is still reserved for you.\n{browse.view_link(token)}\n\n{args.why}",thread_id=notify._live_topic_thread())
            print('A replacement sign-in link was sent.' if sent else 'The sign-in link could not be delivered; your browser remains protected.')
            return 0 if sent else 1
    if op in ('workspaces', 'workspace'):
        from herald import browser_workspaces as bw
        if op == 'workspace':
            print(bw.create(args.name)['id'])
        else:
            for w in bw.all_workspaces():
                print(f"{w['id']}  {w['state']}  generation {w['generation']}")
        return 0
    if op == "crawl":
        jobs = browse.read_jobs(args.urls)
        print(f"crawling {len(jobs)} pages, {args.concurrency} at a time, into {args.out}",
              flush=True)
        r = browse.crawl(jobs, args.out, concurrency=args.concurrency, wait_ms=args.wait,
                         grep=args.grep, profile=args.profile, every=args.every,
                         links=args.links,workspace=args.workspace)
        print(f"done: {r['ok']} read, {r['err']} failed, {r['skipped']} already there, "
              f"{r['seconds']}s. One file per page, first line its final URL"
              + ("; matches.jsonl has the --grep hits." if args.grep else "."))
        return 0
    if op == "status":
        print(f"  profile browser  {'up' if browse.alive() else 'down'} on {browse.cdp_url()}")
        print(f"  profile          {browse.profile_dir()}")
        print(f"  user view        {browse.view_base() or 'off: set surfaces.browser_view.url'}")
        return 0
    if op == "fetch":
        url, text = browse.fetch_text(args.url, args.wait)
        print(url)
        print(browse.UNTRUSTED)
        print(text[:args.max])
        return 0

    with browse.Session(getattr(args,'workspace',None)) as s:
        if op == "tabs":
            for i, p in enumerate(s.pages()):
                print(f"  {i}  {s.tab_id(p)}  {p.title()[:60]!s:<60}  {p.url[:110]}")
            return 0
        if op == "open":
            from herald import browser_workspaces as bw
            bw.admit(s.workspace)
            s.claim_account(args.url)
            if len(s.pages()) >= int(config.get('browser.batch_size',10)):
                raise SystemExit('Workspace tab limit reached; preserve this group before opening more.')
            page = s.ctx.new_page()
            page.goto(args.url, wait_until="domcontentloaded", timeout=60000)
            browse.settle(page, args.wait)
            print(f"tab {s.tab_id(page)}  {page.title()[:70]}  {page.url}")
            return 0
        page = s.tab(args.tab)
        s.claim_account(page.url)
        mutates = op in ('fill','select','check','upload','click','press','go','close')
        if mutates:
            s.checkpoint_page(page,'before-browser-command')
        if op == "close":
            page.close()
            print("closed")
        elif op == "go":
            page.goto(args.url, wait_until="domcontentloaded", timeout=60000)
            browse.settle(page, args.wait)
            print(f"{page.title()[:70]}  {page.url}")
        elif op == "text":
            t = browse.visible_text(page, args.selector)
            print(page.url)
            print(browse.UNTRUSTED)
            print(t[args.offset:args.offset + args.max])
            if len(t) > args.offset + args.max:
                print(f"\n[{len(t) - args.offset - args.max} more characters: "
                      f"--offset {args.offset + args.max}]")
        elif op == "links":
            rx = re.compile(args.match, re.I) if args.match else None
            seen = set()
            for label, href in page.evaluate(browse.LINKS_JS):
                if href in seen or (rx and not (rx.search(label) or rx.search(href))):
                    continue
                seen.add(href)
                print(f"{label[:80]}\t{href}")
        elif op == "fields":
            print(browse.UNTRUSTED)
            for fr in page.frames:
                try:
                    found = fr.evaluate(browse.FIELDS_JS)
                except Exception:
                    continue
                if found:
                    if fr != page.main_frame:
                        print(f"[frame {fr.url[:90]}]")
                    for f in found:
                        print(json.dumps(f, ensure_ascii=False))
            print("buttons: " + " | ".join(page.evaluate(browse.BUTTONS_JS)[:40]))
        elif op in ("fill", "select", "check", "upload"):
            target = f"[data-hb='{args.field}']" if args.field.isdigit() else args.field
            loc = None
            for attempt in (1, 2):
                for fr in page.frames:
                    if fr.locator(target).count():
                        loc = fr.locator(target).first
                        break
                if loc is not None or not args.field.isdigit():
                    break
                # The page re-rendered and dropped the handles (Ashby does after
                # a resume upload). Tag the fields again; the order is the same.
                for fr in page.frames:
                    try:
                        fr.evaluate(browse.FIELDS_JS)
                    except Exception:
                        pass
            if loc is None:
                print(f"no field {args.field!r}; `herald browse fields {args.tab}` lists them",
                      file=sys.stderr)
                return 1
            from herald.application_checkpoints import PROTECTED
            metadata=loc.evaluate("e=>[e.type,e.id,e.name,e.getAttribute('aria-label'),e.labels?[...e.labels].map(x=>x.innerText).join(' '):''].join(' ')")
            if PROTECTED.search(metadata):
                print("refused: a protected value is typed by the user, through "
                      "`herald browse login`, never by a session", file=sys.stderr)
                return 1
            if op == "fill":
                loc.fill(args.value)
            elif op == "select":
                loc.select_option(label=args.value)
            elif op == "check":
                loc.set_checked(args.value.lower() not in ("0", "false", "no", "off"))
            else:
                loc.set_input_files(args.value)
            print(f"{op}: {args.field}")
        elif op == "click":
            if args.target.startswith(("css=", "#", ".", "[", "xpath=")):
                loc = page.locator(args.target.removeprefix("css=")).first
            else:
                loc = page.get_by_role("button", name=args.target).or_(
                    page.get_by_role("link", name=args.target)).or_(
                    page.get_by_text(args.target, exact=False)).first
            label = (loc.inner_text(timeout=5000) or loc.get_attribute("value")
                     or loc.get_attribute("aria-label") or args.target)
            filled = 0
            for fr in page.frames:
                try:
                    filled += fr.evaluate(browse.FILLED_JS)
                except Exception:
                    pass
            browse.refuse_submit(label, filled)
            loc.click(timeout=10000)
            browse.settle(page, args.wait)
            print(f"clicked {label.strip()[:60]!r}; now {page.url}")
        elif op == "press":
            if args.key.lower() == "enter":
                for fr in page.frames:
                    try:
                        if fr.evaluate(browse.ENTER_SUBMITS_JS):
                            browse.refuse_submit("submit (Enter in a form)")
                    except SystemExit:
                        raise
                    except Exception:
                        continue
            page.keyboard.press(args.key)
            browse.settle(page, args.wait)
            print(f"pressed {args.key}; now {page.url}")
        elif op == "scroll":
            page.mouse.wheel(0, args.dy)
            page.wait_for_timeout(800)
            print("scrolled")
        elif op == "shot":
            out = args.path or str(browse.home() / f"shot-{int(time.time())}.png")
            page.screenshot(path=out, full_page=args.full)
            print(out)
        elif op == "html":
            h = page.inner_html(args.selector) if args.selector != "html" else page.content()
            print(browse.UNTRUSTED)
            print(h[:args.max])
        elif op == "login":
            from herald import notify  # noqa: PLC0415
            base = browse.view_base()
            if not base:
                print("no view URL: set surfaces.browser_view.url (see docs/operations.md)",
                      file=sys.stderr)
                return 1
            page.bring_to_front()  # the live screen shows whichever tab is in front
            token = browse.new_view(s.tab_id(page), args.why, args.minutes, workspace=s.workspace)
            url = browse.view_link(token)
            sent = notify.telegram(
                f"A browser tab is waiting for you ({page.url[:80]}).\n{url}\n\n"
                f"Why: {args.why}\n\nWhat you type there goes straight to the "
                f"browser; no model sees it. Works for {args.minutes} minutes."
                + ("\n\nIt is a live screen: tap to click, and use the keyboard "
                   "button in the left-hand menu to type." if "/vnc.html" in url else ""),
                thread_id=notify._live_topic_thread())
            print("the link is on the user's phone" if sent else f"open: {url}")
        if mutates and op != 'close':
            s.checkpoint_page(page,'after-browser-command')
    return 0


def cmd_watch(args) -> int:
    """Pages Herald rechecks until an opportunity opens. See lib/herald/watch.py."""
    from herald import browse, watch  # noqa: PLC0415

    with db.session() as con:
        if args.op == "add":
            if args.pattern:
                re.compile(args.pattern)
            n = con.execute("""UPDATE opportunities SET watch_url=?, watch_for=?,
                               watch_hash=NULL, watch_hit=NULL, watch_error=NULL
                               WHERE id=?""", (args.url, args.pattern, args.id)).rowcount
            if not n:
                print(f"no opportunity #{args.id}", file=sys.stderr)
                return 1
            print(f"watching #{args.id}: {args.url}"
                  + (f" for /{args.pattern}/" if args.pattern else " for any change"))
            if args.now:
                row = con.execute("SELECT * FROM opportunities WHERE id=?", (args.id,)).fetchone()
                r = watch.check(con, row, browse.fetch_text)
                print(f"  now: {r['event']}" + (f" -- {r['excerpt']}" if r.get("excerpt") else "")
                      + (f" -- {r['error']}" if r.get("error") else ""))
            return 0
        if args.op == "rm":
            con.execute("UPDATE opportunities SET watch_url=NULL, watch_for=NULL WHERE id=?",
                        (args.id,))
            print(f"stopped watching #{args.id}")
            return 0
        if args.op == "check":
            rows = watch.due(con)
            if args.id:
                rows = [r for r in rows if r["id"] == args.id]
            for row in rows:
                r = watch.check(con, row, browse.fetch_text)
                con.commit()
                print(f"  #{r['id']} {r['event']:<8} {r['title'][:60]}"
                      + (f"\n      {r['excerpt']}" if r.get("excerpt") else "")
                      + (f"\n      {r['error']}" if r.get("error") else ""))
            return 0
        rows = watch.due(con)
        if not rows:
            print("  nothing watched")
        for r in rows:
            state = "OPEN" if r["watch_hit"] else ("error" if r["watch_error"] else "waiting")
            print(f"  #{r['id']:<4} {state:<8} checked {(r['watch_checked'] or 'never')[:16]}"
                  f"  {r['title'][:55]}\n        {r['watch_url']}"
                  + (f"  /{r['watch_for']}/" if r["watch_for"] else ""))
    return 0


def cmd_apply(args) -> int:
    """Fill job applications from the answer bank. Never submits. See lib/herald/apply.py."""
    from herald import apply as ap  # noqa: PLC0415
    from herald import browser_workspaces as bw
    touched = set()

    def handoff(r, partial=False):
        workspace = r.get('workspace')
        if workspace:
            touched.add(workspace)
            group = bw.ready_group(workspace,partial=partial)
            if group:
                bw.publish(group)
                print('A protected application group was sent to your phone.')

    def report_error(label,e):
        # Playwright errors may embed a navigation query or the value typed.
        detail = str(e)[:300] if isinstance(e,bw.Busy) else 'Operation interrupted; checkpoint preserved. Inspect the draft before retrying.'
        print(f'{label}: {type(e).__name__}: {detail}')

    def show(r):
        if r.get('skipped'):
            print(f"{r['company']}: already {r['skipped']}; no form opened")
            return
        mark = "ready for review" if r.get("done") and not r["pending"] and not r.get("failed") else "waiting on answers"
        print(f"#{r['app']} {r['company']}: {r['title'][:60]} ({r['ats']}, tab {r['tab']}) {mark}; "
              f"{len(r['filled'])} filled" + (f", step {r['step']}" if r.get("step") else ""))
        for f in r["failed"]:
            print(f"   failed: {f}")
        for q in r["pending"]:
            print(f"   ? {q['q'][:150]}" + (f"  [{' | '.join(q['options'][:12])}]" if q.get("options") else "")
                  + ("" if q.get("required") else "  (optional)"))

    if args.op in ("packets", "desk", "worker", "check", "close", "show"):
        from herald import packets
        if args.op == "worker":
            return packets.worker()
        if args.op == "check":
            ok, why = packets.check_ready(args.id)
            print(json.dumps({"ok": ok, "why": why}))
            return 0
        if args.op == "close":
            packets._close_tab(args.id)
            return 0
        if args.op == "show":
            print(json.dumps({"tab": packets.show(args.id)}))
            return 0
        if args.op == "desk":
            url = packets.desk_url(packets.desk_token())
            if not url:
                raise SystemExit("set surfaces.browser_view.url first")
            if args.print:
                print(url)
            else:
                from herald import notify
                notify.telegram("Your application desk. Review answers here, approve, then submit each form when it shows as ready:\n" + url)
                print("sent")
            return 0
        with db.session() as con:
            marks = ",".join("?" * len(ap.DONE))
            ids = args.ids or [r[0] for r in con.execute(
                f"SELECT id FROM applications WHERE status NOT IN ({marks}) ORDER BY id", ap.DONE)]
        for i in ids:
            try:
                p = packets.build(i, refresh=args.refresh)
            except Exception as e:
                print(f"#{i}: {type(e).__name__}: {str(e)[:200]}")
                continue
            flags = [q["flag"] for q in p["questions"]]
            print(f"#{i} {p['state']:<9} {p['source'] or '':<10} {len(flags):>3} questions, "
                  f"{flags.count('review')} to read, {flags.count('missing')} missing"
                  + (f" | {p['blockers'][0][:90]}" if p['blockers'] else ""))
        return 0
    if args.op == "fill":
        for url in args.urls:
            try:
                r=ap.run(url, opportunity=args.opp, company=args.company,workspace=args.workspace,retry=args.retry)
                show(r);handoff(r)
            except SystemExit:
                raise
            except Exception as e:
                from herald.application_checkpoints import safe_url
                report_error(safe_url(url),e)
        for workspace in tuple(touched):
            handoff({'workspace':workspace},partial=True)
        return 0
    if args.op == "refill":
        with db.session() as con:
            marks = ",".join("?" * len(ap.DONE))
            rows = con.execute(f"SELECT id, url FROM applications WHERE status NOT IN ({marks})"
                               + (f" AND id IN ({','.join(str(int(i)) for i in args.ids)})" if args.ids else ""),
                               ap.DONE).fetchall()
        for r in rows:
            try:
                result=ap.run(r["url"],workspace=getattr(args,'workspace',None),retry=getattr(args,'retry',False))
                show(result);handoff(result)
            except Exception as e:
                report_error(f"#{r['id']}",e)
        for workspace in tuple(touched):
            handoff({'workspace':workspace},partial=True)
        return 0
    if args.op == 'review':
        if args.group:
            bw.publish(args.group)
        else:
            groups={}
            for i in args.ids:
                bound=bw.binding(i)
                if not bound:raise SystemExit('An application has no browser checkpoint; recover and verify it before review.')
                groups.setdefault(bound['workspace'],[]).append(i)
            for workspace,ids in groups.items():
                group=bw.ready_group(workspace,partial=True,app_ids=ids)
                if group:bw.publish(group)
        return 0
    if args.op == "pending":
        with db.session() as con:
            qs = ap.pending_all(con)
        if not qs:
            print("nothing pending")
        for q in qs:
            print(f"#{q['app']} {q['company']} | {q['q'][:200]}"
                  + (f" | options: {' | '.join(q['options'][:20])}" if q.get("options") else "")
                  + ("" if q.get("required") else " | optional"))
        return 0
    if args.op == "answer":
        raw = pathlib.Path(args.json).read_text() if os.path.exists(args.json) else args.json
        items = json.loads(raw)
        apps = set()
        with db.session() as con:
            for it in items:
                where = ap.store_answer(con, label=it["q"], value=it.get("a"),
                                        app_id=it.get("app") if it.get("keep", "app") == "app" else None,
                                        pattern=it.get("pattern"),
                                        scope=it.get("company") if it.get("keep") == "company" else None)
                print(f"saved to {where}: {it['q'][:70]}")
                if it.get("app"):
                    apps.add(it["app"])
        if apps and not args.no_refill:
            args.op, args.ids = "refill", sorted(apps)
            return cmd_apply(args)
        return 0
    if args.op == "snapshot":
        with db.session() as con:
            marks = ",".join("?" * len(ap.DONE))
            ids = args.ids or [r[0] for r in con.execute(
                f"SELECT id FROM applications WHERE status NOT IN ({marks})", ap.DONE)]
            for i in ids:
                print(f"#{i}: {ap.snapshot(con, i)} fields saved")
        return 0
    if args.op == "list":
        with db.session() as con:
            for r in con.execute("SELECT * FROM applications ORDER BY status, id"):
                n = len(json.loads(r["pending"] or "[]"))
                print(f"#{r['id']:<3} {r['status']:<10} {(r['company'] or '')[:18]:<18} {(r['title'] or '')[:50]:<50}"
                      + (f" {n} pending" if n else ""))
        return 0
    if args.op == "mark":
        with db.session() as con:
            ap.set_state(con, args.id, status=args.status, note=args.note)
        print(f"#{args.id} {args.status}")
        return 0
    if args.op == "code":
        import datetime as _dt
        v = ap.verification(_dt.datetime.now() - _dt.timedelta(minutes=args.minutes), hint=args.hint,
                            wait_s=args.wait)
        print(json.dumps(v) if v else "no verification mail")
        return 0 if v else 1
    return 0


def cmd_places(args) -> int:
    from herald import places
    if args.action == "update":
        regs = args.region or places.regions()
        if not regs:
            print("herald places: no regions. Set places.regions, e.g. "
                  "herald config set places.regions '[\"north-america/us/district-of-columbia\"]'",
                  file=sys.stderr)
            return 2
        pbfs = []
        for r in regs:
            out = places.DIR / (r.replace("/", "_") + ".osm.pbf")
            if args.no_download and out.exists():
                pbfs.append(out)
                continue
            print(f"downloading {r}", file=sys.stderr)
            pbfs.append(places.download(r))
        print(f"{places.build(pbfs)} places indexed into {places.DB_PATH}")
        return 0
    try:
        if args.action == "get":
            con = places.connect()
            rows = con.execute("SELECT * FROM places WHERE name LIKE ? LIMIT ?",
                               (f"%{args.name}%", args.limit)).fetchall()
            for r in rows:
                print(json.dumps({**dict(r), "tags": json.loads(r["tags"])}, ensure_ascii=False))
            return 0 if rows else 1
        lat, lon, label = places.resolve(args.where)
        when = None
        if args.open_at:
            when = (dt.datetime.now(config.tz()).replace(tzinfo=None) if args.open_at == "now"
                    else dt.datetime.fromisoformat(args.open_at))
        kinds = None if args.kind == "any" else tuple(args.kind.split(","))
        rows = places.near(lat, lon, radius_m=args.radius, kinds=kinds, cuisine=args.cuisine,
                           open_at=when, open_for_min=args.open_for,
                           include_unknown=not args.known_only)
    except (FileNotFoundError, LookupError) as e:
        print(f"herald places: {e}", file=sys.stderr)
        return 1
    rows = rows[: args.limit]
    if args.json:
        for r in rows:
            print(json.dumps(r, ensure_ascii=False))
        return 0
    print(f"# {len(rows)} near {label} ({lat:.5f}, {lon:.5f})", file=sys.stderr)
    for r in rows:
        state = {True: "open", False: "closed", None: "hours?"}.get(r.get("open"), "")
        until = places.closes(r["opening_hours"], when) if when and r.get("open") else None
        print("\t".join([f"{r['distance_m']}m", r["name"], r["kind"].split("=")[-1],
                         r["cuisine"] or "", state + (f" to {until}" if until else ""),
                         r["opening_hours"] or "", r["website"] or ""]))
    return 0


def cmd_find(args) -> int:
    from herald import find as find_mod
    q = find_mod.Query(
        patterns=args.patterns,
        ignore_case=args.ignore_case,
        regex=args.regex,
        basename=args.basename,
        limit=args.limit,
        fresh=[pathlib.Path(d) for d in args.fresh],
    )
    try:
        a = find_mod.find(q)
    except (find_mod.FindError, re.error) as e:
        print(f"herald find: {e}", file=sys.stderr)
        return 2
    if args.count:
        print(len(a.paths))
    else:
        out = sys.stdout.buffer
        end = b"\0" if args.null else b"\n"
        for p in a.paths:
            out.write(os.fsencode(p) + end)
        out.flush()
    if not args.quiet:
        notes = [find_mod.describe_age(a.index_age)]
        if a.dropped:
            notes.append(f"{a.dropped} no longer there, left out")
        if a.fresh_only:
            notes.append(f"{a.fresh_only} found only by the live search")
        print(f"herald find: {'; '.join(notes)}", file=sys.stderr)
    return 0 if a.paths else 1


def cmd_prose(args) -> int:
    """Lint text for the stock patterns of machine-written prose.

    The Stop hook does this to every reply on its own. This is for the other
    things a session writes for a reader: a README, a page of site copy, the
    body of an email before it is drafted.
    """
    from herald import prose as prose_mod
    if args.rules:
        for rule in prose_mod.RULES:
            print(f"  {rule.name:16} {rule.weight:5} {rule.advice}")
        for name, (weight, advice) in prose_mod.COUNTED.items():
            print(f"  {name:16} {weight:5} {advice}")
        return 0
    if args.stats:
        log = config.RAW / "prose.log"
        counts, flagged, clean, still = {}, 0, 0, 0
        for line in (log.read_text().splitlines() if log.exists() else []):
            parts = line.split()
            if len(parts) < 2:
                continue
            if parts[1] in ("FLAG", "WARN"):
                flagged += 1
                for name in parts[-1].removeprefix("rules=").split(","):
                    counts[name] = counts.get(name, 0) + 1
            elif parts[1] == "REWROTE":
                clean += parts[2] == "clean"
                still += parts[2] != "clean"
        print(f"  {flagged} replies flagged; {clean} rewrites came back clean, "
              f"{still} did not")
        for name, n in sorted(counts.items(), key=lambda kv: -kv[1]):
            print(f"  {n:5}  {name}")
        return 0
    off = config.get("prose.off", []) or []
    worst = 0
    for name in args.files or ["-"]:
        text = sys.stdin.read() if name == "-" else pathlib.Path(name).read_text()
        hits = prose_mod.lint(text, off=off)
        if not hits:
            continue
        print(_c(f"{'stdin' if name == '-' else name}: {len(hits)} hit(s)",
                 BAD if prose_mod.flagged(hits) else WARN))
        print(prose_mod.report(hits, limit=args.limit))
        worst = max(worst, 1 if prose_mod.flagged(hits) else 0)
    return worst


def cmd_amber(args) -> int:
    """Amber changes, the ones a scheduled cycle may make. See lib/herald/amber.py.

    Kept apart from `herald act` so a cycle's allowlist can name this and never
    reach a red kind.
    """
    from herald import amber  # noqa: PLC0415

    try:
        if args.kind == "find":
            for ev in amber.find(args.calendar, args.day):
                print(json.dumps({k: ev[k] for k in
                                  ("id", "summary", "start", "end", "location")}))
            return 0
        with db.session() as con:
            if args.kind == "update":
                ev = amber.event_update(
                    con, actor=args.actor, calendar_name=args.calendar,
                    event=args.event, why=args.why, summary=args.summary,
                    location=args.location, start=args.start, end=args.end,
                    description=args.description)
            elif args.kind == "cancel":
                ev = amber.event_cancel(con, actor=args.actor,
                                        calendar_name=args.calendar,
                                        event=args.event, why=args.why)
            elif args.kind == "create":
                ev = amber.event_create(
                    con, actor=args.actor, calendar_name=args.calendar,
                    summary=args.summary, start=args.start, end=args.end,
                    location=args.location or "", description=args.description or "",
                    why=args.why)
            elif args.kind == "task":
                ev = amber.task_create(con, actor=args.actor, title=args.title,
                                       why=args.why, due=args.due,
                                       list_name=args.list)
            else:
                print(f"unknown kind {args.kind}", file=sys.stderr)
                return 1
    except amber.Refused as e:
        print(f"refused: {e}", file=sys.stderr)
        return 2
    if ev is None:
        print(json.dumps({"state": "unchanged"}))
    else:
        print(json.dumps({"state": "done", "id": ev.get("id"),
                          "summary": ev.get("summary") or ev.get("title"),
                          "location": ev.get("location")}))
    return 0



def cmd_context(args) -> int:
    """One bounded retrieval, with metadata-only measurements outside private mode."""
    topic = ' '.join(args.topic)
    started = time.perf_counter()
    if args.budget < 0 or (args.budget and args.budget < 256):
        print('--budget must be 0 or at least 256 approximate tokens', file=sys.stderr)
        return 2
    if args.offset < 0 or not 1 <= args.limit <= 100 or not 1 <= args.days <= 3660:
        print('choose offset >= 0, limit 1..100, days 1..3660', file=sys.stderr)
        return 2
    if args.id is not None and args.view not in context_mod.VIEWS:
        print('--id requires a record view', file=sys.stderr)
        return 2
    if ((args.view or args.schema) and (args.file or args.section or args.sections)
            or args.section and args.sections):
        print('choose a record view/schema or a note section, not both', file=sys.stderr)
        return 2
    try:
        with db.session() as con:
            if topic == 'stats':
                print(context_mod.stats(con), end='')
                return 0
            if topic == 'lint':
                print('\n'.join(context_mod.lint()) or 'no problems found')
                return 0
            result = context_mod.packet(con, topic=topic, view=args.view, file=args.file,
                                        section=args.section, list_sections=args.sections,
                                        days=args.days, offset=args.offset, limit=args.limit,
                                        record_id=args.id, all_statuses=args.all, schema=args.schema)
            output, shown, more = context_mod.render(result, args.budget)
            try:
                retrieval_id = context_mod.record(con, result['category'], started, output, shown, more,
                                                  parent=args.followup)
            except sqlite3.Error:
                con.rollback()
                retrieval_id = None
                print('Retrieval measurements unavailable; evidence read succeeded.', file=sys.stderr)
        print(output, end='')
        if retrieval_id is not None:
            print(f'[retrieval {retrieval_id}; link a further lookup with --followup {retrieval_id}]', file=sys.stderr)
        return 0
    except (ValueError, OSError, sqlite3.Error) as error:
        # Do not echo a topic, SQL parameters, source text or exception payload.
        message = str(error) if isinstance(error, ValueError) else 'context unavailable; inspect source health or permissions'
        print(message, file=sys.stderr)
        return 2


def cmd_search(args) -> int:
    """Ranked keyword search across notes, journals, conversations and sources."""
    started = time.perf_counter()
    try:
        if args.show:
            print(search_mod.show(args.show), end='')
            return 0
        found = search_mod.find(' '.join(args.query), kinds=args.kind, since=args.since,
                                until=args.until, limit=args.limit)
        output = search_mod.render(found, args.budget)
        print(output, end='')
    except (ValueError, sqlite3.Error) as error:
        print(str(error) if isinstance(error, ValueError) else 'search unavailable', file=sys.stderr)
        return 2
    with db.session() as con:
        context_mod.record(con, 'search', started, output, len(found['results']),
                           found['total'] > len(found['results']))
    return 0


# What `herald` will run from inside a private session: the subcommands that
# only read. An allowlist, so a subcommand added later is refused there until
# someone decides it is a read.
PRIVATE_READS = {"status", "db", "fact", "find", "latency", "session", "check", "context", "search"}
PRIVATE_READ_OPS = {"obligation": ("op", {"list"}), "deadline": ("op", {"list"}),
                    "safety": ("op", {"status", "test"}), "root": ("op", {"status"}),
                    "secret": ("op", {"has", "status"}),
                    "config": ("action", {"get", "path"}), "ext": ("action", {"list", "check"})}


def _reads_only(args) -> bool:
    if args.cmd in PRIVATE_READS:
        return True
    attr, allowed = PRIVATE_READ_OPS.get(args.cmd, (None, ()))
    return bool(attr) and getattr(args, attr, None) in allowed


