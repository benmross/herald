    ctx.add_argument('--limit', type=int, default=10)
    ctx.add_argument('--budget', type=int, default=1500, help='approximate tokens (UTF-8 bytes / 4); 0 for whole evidence')
    ctx.add_argument('--followup', type=int, help='link an additional retrieval to a previous retrieval id')
    ctx.set_defaults(fn=cmd_context)

    srch = sub.add_parser('search', help='ranked keyword search over notes, journals, conversations, mail and messages')
