                   help="read anything, save and change nothing: a read-only "
                        "sandbox, no runs row, no transcript kept")
    t.add_argument("-v", "--verbose", action="store_true")
    t.set_defaults(fn=cmd_think)

    d = sub.add_parser("db", help="query the ledger")
