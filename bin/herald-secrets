#!/usr/bin/env python3
"""The page a secret is pasted into. See lib/herald/secretintake.py.

Binds to 127.0.0.1 only. Whatever puts it in front of the user's phone (on a
tailnet, `tailscale serve`) is the install's choice and its config, and the
URL it ends up at is `surfaces.secret_intake.url`.

Two routes, both keyed by a one-time token: GET shows what is being asked for,
POST stores it. Anything else, and any token that is unknown, used or expired,
gets the same plain 404, so the page says nothing about which tokens exist.
The submitted value is never logged, echoed or put in an error.
"""

from __future__ import annotations

import html
import pathlib
import sys
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))

from herald import config, notify, secretintake  # noqa: E402

HEADERS = {
    "Cache-Control": "no-store",
    "Referrer-Policy": "no-referrer",
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "Content-Security-Policy":
        "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; "
        "frame-ancestors 'none'",
}

STYLE = """
body{font:16px/1.45 -apple-system,system-ui,sans-serif;max-width:34rem;
margin:2rem auto;padding:0 1rem;color:#1b1b1b;background:#fafafa}
code{font:15px ui-monospace,Menlo,monospace;background:#eee;padding:.1em .3em;border-radius:3px}
textarea{width:100%;box-sizing:border-box;min-height:7rem;font:15px ui-monospace,Menlo,monospace;
padding:.6rem;border:1px solid #bbb;border-radius:6px}
button{font-size:17px;padding:.6rem 1.4rem;margin-top:.8rem;border:0;border-radius:6px;
background:#1b1b1b;color:#fff}
.why{border-left:3px solid #bbb;padding-left:.8rem;color:#444}
.small{font-size:14px;color:#666}
.err{color:#a00}
@media (prefers-color-scheme:dark){body{background:#151515;color:#e8e8e8}
code{background:#2a2a2a}textarea{background:#1f1f1f;color:#e8e8e8;border-color:#444}
button{background:#e8e8e8;color:#151515}.why{color:#bbb;border-color:#555}.small{color:#999}}
"""


def page(title: str, body: str) -> bytes:
    return (f"<!doctype html><meta charset=utf-8>"
            f"<meta name=viewport content='width=device-width,initial-scale=1'>"
            f"<meta name=robots content=noindex><title>{html.escape(title)}</title>"
            f"<style>{STYLE}</style>{body}").encode()


def form(req: dict, error: str = "") -> bytes:
    name = config.get("agent.name") or "Herald"
    left = max(1, int((req["expires"] - secretintake._now()) // 60))
    notes = [f"This link works once and expires in {left} minute{'s' * (left != 1)}."]
    if req["replaces"]:
        notes.append("A value is already stored here, and this replaces it.")
    if req["json"]:
        notes.append("Paste JSON; it is stored as structured data.")
    err = f"<p class=err>{html.escape(error)}</p>" if error else ""
    return page("Paste a secret", f"""
<h2>Paste a secret</h2>
<p>{html.escape(name)} is asking for <code>{html.escape(req['path'])}</code>.</p>
<p class=small>Its reason, in its own words:</p>
<p class=why>{html.escape(req['why'])}</p>
{err}
<form method=post autocomplete=off>
<textarea name=value required autofocus autocomplete=off autocapitalize=off
 autocorrect=off spellcheck=false></textarea>
<button type=submit>Store it</button>
</form>
<p class=small>{' '.join(html.escape(n) for n in notes)} The value goes straight
into the secrets file on the server. It is not shown to the model and is never
sent back to this page.</p>""")


GONE = page("Not found", "<h2>Not found</h2><p>This link has expired or was "
            "already used. Ask for a new one.</p>")


class Handler(BaseHTTPRequestHandler):
    server_version = "herald-secrets"
    sys_version = ""

    def log_message(self, fmt, *args):  # the path holds the token; keep it out
        sys.stderr.write(f"{self.command} {self.address_string()} -> {args[1] if len(args) > 1 else ''}\n")

    def _send(self, code: int, body: bytes) -> None:
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        for k, v in HEADERS.items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def _token(self) -> str | None:
        parts = urllib.parse.urlsplit(self.path).path.strip("/").split("/")
        return parts[1] if len(parts) == 2 and parts[0] == "s" else None

    def do_GET(self):  # noqa: N802
        req = secretintake.find(self._token() or "")
        self._send(200, form(req)) if req else self._send(404, GONE)

    def do_POST(self):  # noqa: N802
        token = self._token() or ""
        req = secretintake.find(token)
        if not req:
            return self._send(404, GONE)
        length = int(self.headers.get("Content-Length") or 0)
        if length > secretintake.MAX_VALUE * 4:
            return self._send(413, form(req, "That is far too long to be a secret."))
        fields = urllib.parse.parse_qs(self.rfile.read(length).decode("utf-8", "replace"),
                                       keep_blank_values=True)
        try:
            req = secretintake.store(token, (fields.get("value") or [""])[0])
        except LookupError:
            return self._send(404, GONE)
        except ValueError as exc:
            return self._send(400, form(req, str(exc)))
        del fields
        self._send(200, page("Stored", f"<h2>Stored</h2><p><code>"
                             f"{html.escape(req['path'])}</code> is set. You can close "
                             f"this page.</p>"))
        try:
            notify.telegram(f"Stored `{req['path']}` from the paste page.",
                            thread_id=req.get("thread_id"))
        except Exception:  # noqa: BLE001  the value is stored; a missed ping is not fatal
            pass

    def do_HEAD(self):  # noqa: N802
        self.send_response(404)
        self.end_headers()


def main() -> int:
    secretintake.prune()
    srv = ThreadingHTTPServer(("127.0.0.1", secretintake.port()), Handler)
    print(f"herald-secrets on 127.0.0.1:{secretintake.port()}", flush=True)
    srv.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
