[Unit]
Description=Herald — Telegram bridge (one session per conversation, not one forever)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=300
TimeoutStartSec=90
TimeoutStopSec=45
Slice=herald-control.slice
WorkingDirectory={{ROOT}}
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH={{GOOGLE}}
# Without this, Python buffers stdout when it is not a TTY and every log line
# this service prints sits in the buffer indefinitely -- the journal showed the
# service starting and nothing else while it was happily answering messages.
Environment=PYTHONUNBUFFERED=1
Environment=HERALD_WORKER_PARENT=herald-telegram.service
ExecStart={{ROOT}}/venv/bin/python {{ROOT}}/bin/herald-telegram
Restart=always
RestartSec=5

# Models and their tools run in herald-work.slice, outside this budget.
MemoryLow=128M
MemoryHigh=512M
MemoryMax=1G
ManagedOOMPreference=omit
OOMScoreAdjust=100
NoNewPrivileges=true

# 8 Sep 2026: a connection leak ate the default 1024 in seven hours.
# The leak is gone, but headroom gives herald-watchdog several 5-minute
# ticks to catch a future one at 85% instead of finding the corpse.
LimitNOFILE=4096

[Install]
WantedBy=default.target
