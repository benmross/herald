[Unit]
Description=Herald — the one-time page a secret is pasted into from a phone
After=network-online.target

[Service]
Type=simple
WorkingDirectory={{ROOT}}
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart={{ROOT}}/venv/bin/python {{ROOT}}/bin/herald-secrets
Restart=always
RestartSec=10
MemoryMax=200M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
